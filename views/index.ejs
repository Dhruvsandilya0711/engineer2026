<!DOCTYPE html>
<html lang="en" data-palette="<%= typeof palette !== 'undefined' ? palette : '' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ENGINEER '26 — Cognitrixx: Rewire Reality</title>
  <meta name="description" content="ENGINEER '26 — NITK Surathkal's technical festival. Cognitrixx: Rewire Reality. 23—25 October 2026.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <link href="/src/output.css" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <!-- Sitewide atmosphere. One fixed, low-density neural field runs behind the
       whole page (the hero and transformation sections layer their own,
       purpose-built fields on top), plus circuit grid, CRT scanlines and a
       vignette that keeps all of it off the body copy. -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div data-field="ambient" data-priority="2" data-density="1.06" data-tone="nebula" data-signals="9" data-spread="13" data-rotate="0.012" data-depth="18" class="absolute inset-0"></div>
    <div class="bg-grain absolute inset-0"></div>
    <div class="scanlines absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_entry') %>
  <%- include('partials/_nav', { deferred: true }) %>

  <main class="relative z-10">
    <%# Flow: SYSTEM INTRO -> HERO -> COGNITRIXX / REWIRE -> THE DECK
        (01 ABOUT / 02 EVENTS / 03 SCHEDULE / 04 TEAM / 05 SPONSORS,
        stacked — Sponsors now lives inside the deck, not as its own
        section) -> GALLERY -> FINAL REWIRE -> FOOTER.
        The NITK section is gone: the campus is already named in the hero
        kicker, the About card and the footer. %>
    <%- include('partials/_hero', { festDates }) %>
    <%- include('partials/_cognitrixx-intro', { festDates }) %>
    <%- include('partials/_transformation') %>
    <%- include('partials/_seam') %>
    <%- include('partials/_deck', { fest, events, tracks, proshows }) %>
    <%- include('partials/_seam') %>
    <%- include('partials/_signal-range') %>
    <%- include('partials/_seam') %>
    <%- include('partials/_gallery', { gallery }) %>
    <%- include('partials/_legacy') %>
    <%- include('partials/_final-cta') %>
  </main>

  <%- include('partials/_footer') %>

  <script type="module" src="/js/main.js"></script>
</body>
</html>

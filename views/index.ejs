<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ENGINEER '26 — Cognitrixx: Rewire Reality</title>
  <meta name="description" content="ENGINEER '26 — NITK Surathkal's technical festival. Cognitrixx: Rewire Reality. 23—25 October 2026.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <link href="/src/output.css" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <!-- Sitewide atmosphere. One fixed, low-density neural field runs behind the
       whole page (the hero and transformation sections layer their own,
       purpose-built fields on top), plus circuit grid, CRT scanlines and a
       vignette that keeps all of it off the body copy. -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <canvas data-canvas="neural" data-tone="ambient" class="absolute inset-0"></canvas>
    <div class="bg-grain absolute inset-0"></div>
    <div class="scanlines absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_entry') %>
  <%- include('partials/_nav') %>

  <main class="relative z-10">
    <%- include('partials/_hero', { festDates }) %>
    <%- include('partials/_cognitrixx-intro') %>
    <%- include('partials/_transformation') %>
    <%- include('partials/_events-preview', { events }) %>
    <%- include('partials/_nitk') %>
    <%- include('partials/_speakers') %>
    <%- include('partials/_schedule-preview', { scheduleDays }) %>
    <%- include('partials/_legacy') %>
    <%- include('partials/_sponsors') %>
    <%- include('partials/_final-cta') %>
  </main>

  <%- include('partials/_footer') %>

  <script type="module" src="/js/main.js"></script>
</body>
</html>

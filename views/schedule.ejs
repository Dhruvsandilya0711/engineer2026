<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Schedule — ENGINEER '26 · Cognitrixx</title>
  <meta name="description" content="The ENGINEER '26 schedule — three days at NITK Surathkal, <%= festDates.display %>.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/cognitrixx-icon-64.png?v=<%= assetV %>">
  <link rel="icon" href="/favicon.ico?v=<%= assetV %>" sizes="any">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=<%= assetV %>">
  <link href="/src/output.css?v=<%= assetV %>" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div data-field="ambient" data-priority="2" data-density="0.9" data-tone="nebula" data-signals="6" data-spread="13" data-rotate="0.012" data-depth="18" class="absolute inset-0"></div>
    <div class="bg-grain absolute inset-0"></div>
    <div class="scanlines absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_nav', { activeNav: 'schedule' }) %>

  <main class="relative z-10 pt-28 pb-20">
    <div class="rail">

      <%
        const schedTitle = `Three days.<br><span class="text-gradient-impossible">One sequence.</span>`;
        const schedMeta = `<p class="font-mono text-xs text-[var(--paper-dim)] tracking-[0.1em] uppercase">`
          + `<span class="text-paper">${days.length}</span> days &middot; `
          + `<span class="text-paper">${totalSlots}</span> sessions<br>`
          + `<span class="text-[var(--paper-faint)]">${festDates.display} &middot; NITK Surathkal</span></p>`;
      %>
      <%- include('partials/_page-hero', { accent: 'var(--bay-4)', num: '03', nav: 'Schedule', kicker: 'Cognitrixx / timetable', title: schedTitle, meta: schedMeta }) %>

      <div class="hud-frame mt-6" style="--accent: var(--bay-4)">
        <div class="hud-frame__inner"><div class="hud-frame__body">

      <!-- Day tabs. Without JS every day renders stacked below, so the tabs are
           an enhancement rather than a requirement for reaching content. -->
      <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter by day" data-js="day-tabs">
        <button type="button" class="cat-chip is-active" data-day="all" aria-pressed="true">All days</button>
        <% days.forEach(function(day){ %>
        <button type="button" class="cat-chip" data-day="<%= day.id %>" aria-pressed="false">
          <%= day.label %> · <%= new Date(day.date).getDate() %> Oct
          <span class="cat-chip__n"><%= day.slots.length %></span>
        </button>
        <% }); %>
      </div>

      <!-- ============ DAYS ============ -->
      <% days.forEach(function(day){ %>
      <section class="mb-14" data-js="day-block" data-day="<%= day.id %>" aria-labelledby="<%= day.id %>-heading">
        <div class="section-head">
          <h2 id="<%= day.id %>-heading" class="font-display font-semibold text-xl">
            <%= day.label %>
            <span class="font-mono text-xs tracking-[0.12em] uppercase text-amber ml-3"><%= day.weekday %></span>
          </h2>
          <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase">
            <%= new Date(day.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </p>
        </div>

        <% if (day.slots.length) { %>
        <ol class="schedule-track">
          <% day.slots.forEach(function(slot){ %>
          <li class="schedule-slot<%= slot.when ? '' : ' is-tba' %>">
            <%# One line per slot: "10:00–17:00", "From 10:00", "All day", or
                coming soon while the sheet still has it as TBD. The end time
                drops to its own line so the column stays narrow. %>
            <span class="schedule-slot__time">
              <% if (slot.allDay) { %>All day
              <% } else if (!slot.time) { %><span class="schedule-slot__tba">Time<br>coming soon</span>
              <% } else { %><%= slot.time %><span class="schedule-slot__end"><%= slot.endTime ? '– ' + slot.endTime : 'onwards' %></span><% } %>
            </span>
            <span class="schedule-slot__body">
              <% if (slot.linkedEvent) { %>
                <a href="/events/<%= slot.linkedEvent.slug %>" class="schedule-slot__title hover:text-cyan transition-colors"><%= slot.title %></a>
              <% } else { %>
                <span class="schedule-slot__title"><%= slot.title %></span>
              <% } %>
              <span class="schedule-slot__meta">
                <span class="<%= slot.venue ? 'text-[var(--paper-dim)]' : 'text-amber' %>"><%= slot.venue || 'Venue coming soon' %></span>
                <% if (slot.linkedEvent) { %><span>&middot; <%= slot.linkedEvent.category %></span><% } %>
                <% if (slot.linkedEvent && slot.linkedEvent.organisedBy) { %><span>&middot; <%= slot.linkedEvent.organisedBy %></span><% } %>
                <% if (slot.endNote) { %><span>&middot; Ends <%= slot.endTime %> <%= slot.endNote %></span><% } %>
              </span>
            </span>
          </li>
          <% }); %>
        </ol>
        <% } else { %>
        <!-- Honest empty day: nothing is scheduled, so nothing is shown. -->
        <div class="border border-dashed border-[var(--hairline)] py-12 px-6 text-center">
          <p class="font-mono text-[0.68rem] tracking-[0.18em] uppercase text-amber mb-3">Coming soon</p>
          <p class="text-sm text-[var(--paper-dim)] max-w-md mx-auto">
            Sessions, times and venues for <%= day.label %> are coming soon.
          </p>
        </div>
        <% } %>
      </section>
      <% }); %>

      <!-- ============ AWAITING SCHEDULING ============
           Real events that exist but have no slot yet. Listing them is more
           useful than hiding them, and avoids implying the line-up is thin. -->
      <% if (unscheduled.length) { %>
      <section class="mt-16" aria-labelledby="unscheduled-heading">
        <div class="section-head">
          <h2 id="unscheduled-heading" class="font-display font-semibold text-xl">Timings coming soon</h2>
          <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase"><%= unscheduled.length %> events</p>
        </div>
        <p class="text-sm text-[var(--paper-dim)] mb-6 max-w-2xl">
          These events are confirmed for ENGINEER '26 but haven't been assigned a day and time yet.
          They'll move into the timetable above as scheduling is finalised.
        </p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          <% unscheduled.forEach(function(evt){ %>
          <li>
            <a href="/events/<%= evt.slug %>"
               class="inline-flex items-center gap-2 border border-[var(--hairline)] hover:border-cyan hover:text-cyan transition-colors px-3 py-2 font-mono text-xs">
              <%= evt.name %>
              <span class="text-[var(--paper-faint)]">/ <%= evt.category %></span>
            </a>
          </li>
          <% }); %>
        </ul>
      </section>
      <% } %>

      <aside class="mt-16 border-l-2 border-amber/50 pl-5 py-2">
        <p class="font-mono text-[0.7rem] tracking-[0.15em] uppercase text-amber mb-2">Status</p>
        <p class="text-sm text-[var(--paper-dim)] max-w-2xl">
          Times and venues marked coming soon are still being confirmed, and the schedule may
          change before the fest. Check an event's own page for its latest details.
        </p>
      </aside>
        </div></div></div>
    </div>
  </main>

  <%- include('partials/_footer') %>

  <script type="module" src="/js/motion.js?v=<%= assetV %>"></script>
  <script type="module" src="/js/page.js?v=<%= assetV %>"></script>
  <script type="module" src="/js/schedule.js?v=<%= assetV %>"></script>
</body>
</html>

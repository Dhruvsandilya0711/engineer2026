<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team — ENGINEER '26 · Cognitrixx</title>
  <meta name="description" content="The team behind ENGINEER '26 at NITK Surathkal.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/cognitrixx-icon-64.png?v=<%= assetV %>">
  <link rel="icon" href="/favicon.ico?v=<%= assetV %>" sizes="any">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=<%= assetV %>">
  <link href="/src/output.css?v=<%= assetV %>" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div data-field="ambient" data-priority="2" data-density="0.9" data-tone="nebula" data-signals="6" data-spread="13" data-rotate="0.012" data-depth="18" class="absolute inset-0"></div>
    <div class="bg-grain absolute inset-0"></div>
    <div class="scanlines absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_nav', { activeNav: 'team' }) %>

  <main class="relative z-10 pt-28 pb-20">
    <div class="rail">

      <%
        const teamTitle = `The network<br><span class="text-gradient-impossible">behind it.</span>`;
        const teamMeta = totalMembers
          ? `<p class="font-mono text-xs text-[var(--paper-dim)] tracking-[0.1em] uppercase">`
            + `<span class="text-paper">${totalMembers}</span> members<br>`
            + `<span class="text-[var(--paper-faint)]">ENGINEER '26 &middot; NITK Surathkal</span></p>`
          : '';
      %>
      <%- include('partials/_page-hero', { accent: 'var(--bay-5)', num: '04', nav: 'Team', kicker: 'Cognitrixx / the people', title: teamTitle, meta: teamMeta }) %>

      <p class="text-[var(--paper-dim)] max-w-xl mt-6">
        Cognitrixx is a network of intelligent minds — and the ones that built it are students
        at NITK Surathkal who run ENGINEER every year.
      </p>

      <div class="hud-frame mt-6" style="--accent: var(--bay-5)">
        <div class="hud-frame__inner"><div class="hud-frame__body">

      <% if (totalMembers) { %>
        <!-- ============ ROSTER ============
             Renders whatever data/team.json holds. Groups are derived from the
             members themselves, so no empty section can ever appear. -->
        <%
          // Two-letter monogram for the photo placeholder: first and last word.
          const initials = (n) => {
            const w = String(n || '').replace(/^Prof\.\s*/, '').trim().split(/\s+/).filter(Boolean);
            return w.length ? (w[0][0] + (w.length > 1 ? w[w.length - 1][0] : '')).toUpperCase() : '?';
          };
          let n = 0;
        %>
        <% groups.forEach(function(g){ %>
        <section class="mb-16" aria-labelledby="group-<%= g.group.replace(/\W+/g,'-').toLowerCase() %>">
          <div class="section-head">
            <h2 id="group-<%= g.group.replace(/\W+/g,'-').toLowerCase() %>" class="font-display font-semibold text-xl"><%= g.group %></h2>
            <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase"><%= g.members.length %> members</p>
          </div>

          <%# One grid, one card size for everyone. The reveal sits on the
              <li> and the card inside it, so the entrance and the hover tilt
              never fight over one transform. The accent walks the six nav-bay
              colours, so the wall reads as a spectrum. %>
          <ul class="crew-grid">
            <% g.members.forEach(function(m){ n++; %>
            <li class="crew-cell" data-reveal style="--ci: <%= n %>">
            <article class="crew<%= m.name ? '' : ' crew--tba' %>" data-tilt="7" style="--spot: var(--bay-<%= ((n - 1) % 6) + 1 %>)">
              <div class="crew__in">
                <div class="crew__photo">
                  <% if (m.image) { %>
                    <img src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
                  <% } else { %>
                    <%# Placeholder until the photo arrives: the person's
                        initials in a lit frame, so the grid already reads as
                        people. %>
                    <span class="crew__rings" aria-hidden="true"></span>
                    <span class="crew__mono" aria-hidden="true"><%= m.name ? initials(m.name) : '?' %></span>
                    <span class="crew__ph" aria-hidden="true">Photo soon</span>
                  <% } %>
                </div>
                <span class="crew__holo" aria-hidden="true"></span>
                <span class="crew__idx" aria-hidden="true"><%= String(n).padStart(2, '0') %></span>
                <div class="crew__plate">
                  <p class="crew__name"><%= m.name || 'Coming soon' %></p>
                  <p class="crew__role"><%= m.role %></p>
                  <% if (m.email || m.linkedin) { %>
                  <p class="crew__links">
                    <% if (m.email) { %><a href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>">Email</a><% } %>
                    <% if (m.linkedin) { %><a href="<%= m.linkedin %>" rel="noopener noreferrer" target="_blank" aria-label="<%= m.name %> on LinkedIn">LinkedIn</a><% } %>
                  </p>
                  <% } %>
                </div>
              </div>
            </article>
            </li>
            <% }); %>
          </ul>
        </section>
        <% }); %>

      <% } else { %>
        <!-- ============ EMPTY ROSTER ============
             No team data exists in this codebase. A team page names real people
             in real roles, so nothing is shown rather than inventing a
             committee. The grid above renders automatically once names land in
             data/team.json. -->
        <section class="border border-dashed border-[var(--hairline-strong)] py-20 px-6 text-center">
          <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-magenta mb-4">Coming soon</p>
          <h2 class="font-display font-semibold text-2xl mb-4">The team is coming soon</h2>
          <p class="text-[var(--paper-dim)] text-sm max-w-md mx-auto mb-8">
            Names and roles of the ENGINEER '26 organising committee are coming soon.
            We'd rather show nothing than credit the wrong people.
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="/events" class="btn btn-secondary">Browse events</a>
            <a href="/#footer" class="btn btn-secondary">Get in touch</a>
          </div>
        </section>

        <%# There was a "layout preview" here: four empty skeleton cards under a
             label reading "no real people shown". It was a developer's view of
             the page, shipped to visitors, who got grey boxes plus a note
             explaining the grey boxes. Deleted rather than hidden — the roster
             panel above already says the team is not announced yet, and dead
             markup left behind only waits to be un-hidden by accident. %>
      <% } %>

      <aside class="mt-16 border-l-2 border-magenta/50 pl-5 py-2">
        <p class="font-mono text-[0.7rem] tracking-[0.15em] uppercase text-magenta mb-2">Status</p>
        <p class="text-sm text-[var(--paper-dim)] max-w-2xl">
          <% if (totalMembers) { %>
            Photos are coming soon. Corrections go to the ENGINEER '26 organising team.
          <% } else { %>
            The ENGINEER '26 committee is coming soon.
          <% } %>
        </p>
      </aside>
        </div></div></div>
    </div>
  </main>

  <%- include('partials/_footer') %>

  <script type="module" src="/js/motion.js?v=<%= assetV %>"></script>
  <script type="module" src="/js/page.js?v=<%= assetV %>"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register — ENGINEER '26 · Cognitrixx</title>
  <meta name="description" content="Register for ENGINEER '26 at NITK Surathkal, <%= festDates.display %>.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link href="/src/output.css" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <!-- Registration is a task, not a spectacle: one quiet field, no pinned
       scroll, no scrubbed animation. Design-system §14. -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div data-field="register" data-priority="3" data-density="0.5" data-tone="engi" data-signals="3" data-spread="11" class="absolute inset-0 opacity-40"></div>
    <div class="bg-grain absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_nav', { activeNav: 'register' }) %>

  <main class="relative z-10 pt-28 pb-20 px-6">
    <div class="max-w-xl mx-auto">

      <%
        // The heading names the event being registered for, when there is
        // one. `values.userEvent` reaches here from ?event= or from a failed
        // POST, so it is attacker-controlled text, and the page-hero include
        // below prints its title RAW. It is therefore never interpolated
        // directly: it is matched against the real event list and only our
        // own data is printed. An unrecognised value falls back to the fest
        // name, so a crafted ?event= yields a heading and nothing more.
        const selectedEvent = events.all.find(e => e.name === values.userEvent);
        const headline = selectedEvent
          ? selectedEvent.name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          : `ENGINEER&nbsp;'26`;
        const regTitle = `Register for<br><span class="text-gradient-impossible" data-js="reg-title">${headline}</span>`;
        const regMeta = `<p class="font-mono text-xs text-[var(--paper-dim)] tracking-[0.1em] uppercase">`
          + `${festDates.display}<br><span class="text-[var(--paper-faint)]">NITK Surathkal &middot; one entry per event</span></p>`;
      %>
      <%- include('partials/_page-hero', { accent: 'var(--bay-6)', num: '06', nav: 'Register', kicker: 'Cognitrixx / join the system', title: regTitle, meta: regMeta, stack: true }) %>

      <div class="hud-frame mt-6" style="--accent: var(--bay-6)">
        <div class="hud-frame__inner"><div class="hud-frame__body">

      <% if (status === 'success') { %>
        <div class="border border-[rgba(63,191,143,.45)] bg-charcoal p-7 mb-8" role="status">
          <p class="font-mono text-[0.68rem] tracking-[0.18em] uppercase text-success mb-3">Registered</p>
          <h2 class="font-display font-semibold text-xl mb-3">You're in.</h2>
          <p class="text-sm text-[var(--paper-dim)] mb-6">
            Your registration is recorded. Event details and timings are published on the event pages
            as the organising team confirms them.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/events" class="btn btn-secondary">Browse events</a>
            <a href="/register" class="btn btn-secondary">Register for another</a>
          </div>
        </div>
      <% } %>

      <%# PAYMENT. The server has already created the Razorpay order and
          written an unpaid row for it; this only opens the modal. The form
          is hidden below while this is showing, because re-submitting it
          would create a second order for the same person. %>
      <% if (status === 'pay' && payment) { %>
        <div class="border border-[rgba(59,130,246,.45)] bg-charcoal p-7 mb-8">
          <p class="font-mono text-[0.68rem] tracking-[0.18em] uppercase text-cyan mb-3">Payment</p>
          <h2 class="font-display font-semibold text-xl mb-2"><%= payment.eventName %></h2>
          <p class="text-sm text-[var(--paper-dim)] mb-5">
            <span class="font-display text-2xl text-paper">&#8377;<%= payment.rupees %></span>
            <span class="block mt-2">Your place is held but not confirmed until this is paid.</span>
          </p>

          <p class="lb-msg" data-js="pay-status" role="status" aria-live="polite" hidden></p>

          <noscript>
            <p class="text-sm text-error">
              Card payment needs JavaScript, which is switched off in this browser.
              Turn it on and register again, or email
              <a href="mailto:engineerconvenor@nitk.edu.in">engineerconvenor@nitk.edu.in</a>.
            </p>
          </noscript>

          <button type="button" class="btn btn-primary mt-2" data-js="pay-now">Pay &#8377;<%= payment.rupees %></button>

          <%# Server-issued, and read back by public/js/pay.js. The amount is
              re-derived server-side at verification, so editing this changes
              nothing about what is actually charged or what is accepted. %>
          <script type="application/json" data-js="pay-data"><%- safeJson(payment) %></script>
        </div>
      <% } %>

      <% if (status === 'pay-error') { %>
        <div class="border border-[rgba(232,104,138,.45)] bg-charcoal p-5 mb-8" role="alert">
          <p class="font-mono text-[0.68rem] tracking-[0.18em] uppercase text-error mb-2">Payment unavailable</p>
          <p class="text-sm text-[var(--paper-dim)]">
            We could not start a payment for that event just now, and nothing has been
            charged or recorded. Please try again in a minute.
          </p>
        </div>
      <% } %>

      <% if (status === 'error') { %>
        <div class="border border-[rgba(232,104,138,.45)] bg-charcoal p-5 mb-8" role="alert">
          <p class="font-mono text-[0.68rem] tracking-[0.18em] uppercase text-error mb-2">Could not save</p>
          <p class="text-sm text-[var(--paper-dim)]">Something failed on our side. Nothing was recorded — please try again.</p>
        </div>
      <% } %>

      <% if (status !== 'success' && status !== 'pay') { %>
      <form method="post" action="/register" novalidate class="flex flex-col gap-5" data-js="register-form">

        <div>
          <label for="userName" class="form-label">Full name</label>
          <input id="userName" name="userName" type="text" required autocomplete="name"
            value="<%= (values.userName || '') %>"
            aria-invalid="<%= errors.userName ? 'true' : 'false' %>"
            <%= errors.userName ? 'aria-describedby="err-userName"' : '' %>
            class="form-input <%= errors.userName ? 'has-error' : '' %>">
          <% if (errors.userName) { %><p id="err-userName" class="form-error"><%= errors.userName %></p><% } %>
        </div>

        <div>
          <label for="userRollNumber" class="form-label">Roll number</label>
          <input id="userRollNumber" name="userRollNumber" type="text" required
            value="<%= (values.userRollNumber || '') %>"
            aria-invalid="<%= errors.userRollNumber ? 'true' : 'false' %>"
            <%= errors.userRollNumber ? 'aria-describedby="err-userRollNumber"' : '' %>
            class="form-input <%= errors.userRollNumber ? 'has-error' : '' %>">
          <% if (errors.userRollNumber) { %><p id="err-userRollNumber" class="form-error"><%= errors.userRollNumber %></p><% } %>
        </div>

        <div>
          <label for="userMail" class="form-label">Email</label>
          <input id="userMail" name="userMail" type="email" required autocomplete="email"
            value="<%= (values.userMail || '') %>"
            aria-invalid="<%= errors.userMail ? 'true' : 'false' %>"
            <%= errors.userMail ? 'aria-describedby="err-userMail"' : '' %>
            class="form-input <%= errors.userMail ? 'has-error' : '' %>">
          <% if (errors.userMail) { %><p id="err-userMail" class="form-error"><%= errors.userMail %></p><% } %>
        </div>

        <div>
          <label for="userEvent" class="form-label">Event</label>
          <select id="userEvent" name="userEvent" required
            aria-invalid="<%= errors.userEvent ? 'true' : 'false' %>"
            <%= errors.userEvent ? 'aria-describedby="err-userEvent"' : '' %>
            class="form-input <%= errors.userEvent ? 'has-error' : '' %>">
            <option value="">Select an event…</option>
            <% events.all.forEach(function(evt){ %>
            <%# The fee is shown here, not after submitting. `fees` holds only the
                priced events, so an event missing from it is free and shows no
                price at all. %>
            <option value="<%= evt.name %>" <%= values.userEvent === evt.name ? 'selected' : '' %>><%= evt.name %> — <%= evt.category %><%= fees[evt.name] ? ' · ₹' + fees[evt.name] : '' %></option>
            <% }); %>
          </select>
          <% if (errors.userEvent) { %><p id="err-userEvent" class="form-error"><%= errors.userEvent %></p><% } %>
        </div>

        <button type="submit" class="btn btn-primary justify-center mt-2">Complete registration</button>

        <%# This promised "No payment is taken and no pass is issued"
             unconditionally. The moment an event can carry a fee that became a
             false statement, printed on the form people hand their details to.
             It now describes whichever case actually applies. %>
        <p class="font-mono text-[0.66rem] text-[var(--paper-faint)] leading-relaxed">
          We store your name, roll number, email and chosen event so the organising team can contact you.
          <% if (Object.keys(fees).length) { %>
            Events showing a price are paid — you will see the amount before anything is charged,
            and your ticket is emailed once the payment clears. Every other event is free to enter.
          <% } else { %>
            No payment is taken and no pass is issued.
          <% } %>
        </p>
      </form>
      <% } %>
        </div></div></div>
    </div>
  </main>

  <%- include('partials/_footer') %>
  <script type="module" src="/js/page.js"></script>
  <%# The heading follows the picker. Server-rendered above for the ?event=
      case and for JS-off visitors; this only keeps it in step afterwards. %>
  <script type="module" nonce="<%= nonce %>">
    const title = document.querySelector('[data-js="reg-title"]');
    const picker = document.querySelector('#userEvent');
    if (title && picker) {
      const FALLBACK = "ENGINEER '26";
      picker.addEventListener("change", () => {
        // textContent, not innerHTML — the option label is data, not markup.
        title.textContent = picker.value || FALLBACK;
      });
    }
  </script>
  <% if (status === 'pay' && payment) { %>
  <script type="module" nonce="<%= nonce %>">
    import { initPay } from '/js/pay.js';
    initPay();
  </script>
  <% } %>
</body>
</html>

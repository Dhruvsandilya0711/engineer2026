<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register — ENGINEER '26 · Cognitrixx</title>
  <meta name="description" content="Register for ENGINEER '26 events at NITK Surathkal, <%= festDates.display %>.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/cognitrixx-icon-64.png?v=<%= assetV %>">
  <link rel="icon" href="/favicon.ico?v=<%= assetV %>" sizes="any">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=<%= assetV %>">
  <link href="/src/output.css?v=<%= assetV %>" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div data-field="ambient" data-priority="2" data-density="0.9" data-tone="nebula" data-signals="6" data-spread="13" data-rotate="0.012" data-depth="18" class="absolute inset-0"></div>
    <div class="bg-grain absolute inset-0"></div>
    <div class="scanlines absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_nav', { activeNav: 'register' }) %>

  <%# REGISTER — a directory, not a form. Each event's organisers run their
      own registration (Unstop, Google Forms, a club site); this page gets
      people to the right one. Open events come first as glass cards that
      link straight out; the rest follow, marked coming soon, and move up
      on their own once data/events.json gives them a registrationUrl. %>
  <main class="relative z-10 pt-28 pb-20">
    <div class="rail">

      <%
        const regTitle = `Register.<br><span class="text-gradient-impossible">Pick your event.</span>`;
        const regMeta = `<p class="font-mono text-xs text-[var(--paper-dim)] tracking-[0.1em] uppercase">`
          + `<span class="text-paper">${totals.open}</span> open &middot; `
          + `<span class="text-paper">${totals.soon}</span> opening soon<br>`
          + `<span class="text-[var(--paper-faint)]">${festDates.display} &middot; NITK Surathkal</span></p>`;
      %>
      <%- include('partials/_page-hero', { accent: 'var(--bay-6)', num: '06', nav: 'Register', kicker: 'Cognitrixx / join the system', title: regTitle, meta: regMeta }) %>

      <p class="text-[var(--paper-dim)] max-w-xl mt-6">
        Each event takes registrations on its own form, run by its organisers. Pick one and
        you'll go straight there.
      </p>

      <div class="hud-frame mt-6" style="--accent: var(--bay-6)">
        <div class="hud-frame__inner"><div class="hud-frame__body">

        <%
          // One searchable string per event: name, category and club.
          const hay = (e) => [e.name, e.category, e.organisedBy || ''].join(' ').toLowerCase();
          const statuses = [['all', 'All'], ['open', 'Open now'], ['soon', 'Opening soon']];
        %>
        <!-- ============ SEARCH + FILTERS ============
             A real GET form, so it works with JavaScript off; register-filter.js
             upgrades it to instant filtering and keeps the URL in step. -->
        <form method="get" action="" class="reg-filter" data-js="reg-filter"
              data-status="<%= status %>" data-category="<%= activeCategory %>"
              data-total="<%= totals.open + totals.soon %>" role="search">
          <%# The current choices ride along as hidden fields; a chip's own
              value comes after them, and the server takes the last one. %>
          <input type="hidden" name="status" value="<%= status %>">
          <input type="hidden" name="category" value="<%= activeCategory %>">

          <div class="reg-filter__search">
            <label for="reg-search" class="sr-only">Search events</label>
            <span class="reg-filter__icon" aria-hidden="true">&#8981;</span>
            <input id="reg-search" type="search" name="q" value="<%= query %>"
                   placeholder="Search events or clubs&hellip;"
                   autocomplete="off" data-js="reg-search" class="reg-filter__input">
            <button type="submit" class="reg-filter__go">Search</button>
          </div>

          <div class="reg-filter__row" role="group" aria-label="Registration status">
            <span class="reg-filter__label">Show</span>
            <div class="reg-filter__chips">
            <% statuses.forEach(function (s2) { %>
            <button type="submit" name="status" value="<%= s2[0] %>" data-js="reg-status" data-val="<%= s2[0] %>"
                    class="cat-chip<%= status === s2[0] ? ' is-active' : '' %>" aria-pressed="<%= status === s2[0] %>">
              <%= s2[1] %>
              <span class="cat-chip__n"><%= s2[0] === 'all' ? totals.open + totals.soon : s2[0] === 'open' ? totals.open : totals.soon %></span>
            </button>
            <% }); %>
            </div>
          </div>

          <div class="reg-filter__row" role="group" aria-label="Category">
            <span class="reg-filter__label">Type</span>
            <div class="reg-filter__chips">
            <button type="submit" name="category" value="All" data-js="reg-cat" data-val="All"
                    class="cat-chip<%= activeCategory === 'All' ? ' is-active' : '' %>" aria-pressed="<%= activeCategory === 'All' %>">All</button>
            <% categories.forEach(function (c) { %>
            <button type="submit" name="category" value="<%= c.name %>" data-js="reg-cat" data-val="<%= c.name %>"
                    class="cat-chip<%= activeCategory === c.name ? ' is-active' : '' %>" aria-pressed="<%= activeCategory === c.name %>">
              <%= c.name %> <span class="cat-chip__n"><%= c.count %></span>
            </button>
            <% }); %>
            </div>
          </div>
        </form>

        <p class="reg-filter__count" aria-live="polite">
          <span data-js="reg-count"><%= open.length + soon.length %></span> shown
          <button type="button" class="reg-filter__reset" data-js="reg-reset"<%- (query || status !== 'all' || activeCategory !== 'All') ? '' : ' hidden' %>>Clear filters</button>
        </p>

        <section aria-labelledby="open-now" data-js="reg-section"<%- open.length ? '' : ' hidden' %>>
          <div class="section-head">
            <h2 id="open-now" class="font-display font-semibold text-xl">
              Open now <span class="reg-live" aria-hidden="true"></span>
            </h2>
            <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase"><span data-js="reg-section-count"><%= open.length %></span> events</p>
          </div>

          <ul class="reg-grid">
            <% open.forEach(function (e, i) { %>
            <li class="reg-cell" data-reveal style="--ci: <%= i %>"
                data-js="reg-item" data-status="open" data-cat="<%= e.category %>" data-search="<%= hay(e) %>">
              <div class="reg-card" data-spotlight style="--spot: var(--bay-6)">
                <div class="reg-card__top">
                  <span class="reg-card__idx"><%= String(i + 1).padStart(2, '0') %></span>
                  <span class="reg-card__cat"><%= e.category %></span>
                  <span class="status-pill status-pill--live">Open</span>
                </div>
                <h3 class="reg-card__name"><a href="/events/<%= e.slug %>"><%= e.name %></a></h3>
                <p class="reg-card__meta">
                  <% if (e.organisedBy) { %><span><%= e.organisedBy %></span><% } %>
                  <% e.sessions.forEach(function (s) { %>
                  <span><%= s.day %> &middot; <%= s.when || 'Time soon' %><%= s.venue ? ' · ' + s.venue : '' %></span>
                  <% }); %>
                </p>
                <a class="reg-card__go" href="<%= e.st.url %>" target="_blank" rel="noopener noreferrer" data-js="magnetic">
                  <span>Register</span>
                  <span class="reg-card__host">on <%= e.st.host %> &#8599;</span>
                </a>
              </div>
            </li>
            <% }); %>
          </ul>
        </section>

        <section class="mt-16" aria-labelledby="opening-soon" data-js="reg-section"<%- soon.length ? '' : ' hidden' %>>
          <div class="section-head">
            <h2 id="opening-soon" class="font-display font-semibold text-xl">Opening soon</h2>
            <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase"><span data-js="reg-section-count"><%= soon.length %></span> events</p>
          </div>
          <p class="text-sm text-[var(--paper-dim)] max-w-2xl mb-6">
            Registration links for these are coming soon. Each event's page will carry its link
            the moment it opens.
          </p>
          <ul class="reg-soon">
            <% soon.forEach(function (e) { %>
            <li data-js="reg-item" data-status="soon" data-cat="<%= e.category %>" data-search="<%= hay(e) %>">
              <a href="/events/<%= e.slug %>" class="reg-soon__chip">
                <%= e.name %>
                <span class="reg-soon__cat">/ <%= e.category %></span>
              </a>
            </li>
            <% }); %>
          </ul>
        </section>

        <div class="reg-empty" data-js="reg-empty"<%- (open.length + soon.length) ? ' hidden' : '' %>>
          <p class="font-mono text-xs tracking-[0.2em] uppercase text-amber mb-4">No match</p>
          <h2 class="font-display font-semibold text-2xl mb-3">Nothing here for that</h2>
          <p class="text-[var(--paper-dim)] text-sm max-w-sm mx-auto mb-8">Try a different search, type or status.</p>
          <a href="/register" class="btn btn-secondary" data-js="reg-reset-link">Clear filters</a>
        </div>

        </div></div></div>
    </div>
  </main>

  <%- include('partials/_footer') %>

  <script type="module" src="/js/motion.js?v=<%= assetV %>"></script>
  <script type="module" src="/js/page.js?v=<%= assetV %>"></script>
  <script type="module" src="/js/register-filter.js?v=<%= assetV %>"></script>
</body>
</html>

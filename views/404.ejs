<!DOCTYPE html>
<html lang="en" data-palette="<%= typeof palette !== 'undefined' ? palette : '' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signal lost — ENGINEER '26</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link href="/src/output.css" rel="stylesheet">
</head>
<body class="bg-void text-paper min-h-screen flex items-center justify-center px-6">
  <main class="text-center max-w-md">
    <%# This page answers BOTH 404 and 500 — the error handler renders it
        rather than shipping a second near-identical template. It was telling
        people their request was "not found" when the server had actually
        failed, which sends them off hunting for a typo that is not there. %>
    <% const serverError = (typeof status !== "undefined" && status >= 500); %>
    <p class="font-mono text-xs tracking-[0.16em] uppercase text-cyan mb-4">
      <%= serverError ? "500 / server error" : "404 / page not found" %>
    </p>
    <h1 class="font-display font-bold text-4xl sm:text-5xl text-gradient-impossible mb-4">Signal lost</h1>
    <p class="text-[var(--paper-dim)] mb-8">
      <% if (serverError) { %>
        Something broke on our side. Nothing you did caused it, and nothing you
        submitted was lost &mdash; try again in a moment.
      <% } else { %>
        <code class="font-mono text-sm"><%= url %></code> isn't a page on ENGINEER '26.
      <% } %>
    </p>
    <a href="/" class="btn btn-primary">Return home</a>
  </main>
</body>
</html>

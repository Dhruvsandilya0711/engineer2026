<!-- ==========================================================================
     PRELOADER / boot sequence — design handoff §1.

     LOAD → BURST → WIPE → DONE, driven by public/js/preloader.js.

     The hero renders in the DOM *underneath* this overlay (never behind a
     JS gate), so nothing SEO-relevant is hidden. First visit only
     (sessionStorage); prefers-reduced-motion skips straight to a 200ms fade.
     ========================================================================== -->
<%# The nine bands are opaque black and are server-rendered, so they cover the
    viewport from first paint until preloader.js can take them down — and that
    module sits behind main.js's whole graph (three, gsap, lenis). On a repeat
    visit, where there is no sequence to play, that is a black screen for as
    long as the bundle takes. This parser-blocking gate runs before the overlay
    element even exists, so the skip costs nothing. Same for JS-off, where
    nothing would ever remove the overlay. %>
<script>
  try { if (sessionStorage.getItem('engi26.loaded') === '1') document.documentElement.classList.add('pl-skip'); } catch (e) {}
</script>
<noscript><style>#preloader { display: none; }</style></noscript>
<div id="preloader" role="status" aria-live="polite" aria-label="Loading ENGINEER '26">
  <!-- The nine shutter bands ARE the opaque backdrop: they sit behind the
       overlay's content and collapse during WIPE to reveal the page. They must
       not paint on top, or they black out the sequence they are meant to end. -->
  <div class="pl-bands" data-js="pl-bands" aria-hidden="true">
    <% for (var b = 0; b < 9; b++) { %><span class="pl-band"></span><% } %>
  </div>
  <div class="pl-glows" aria-hidden="true"></div>
  <div class="pl-grid" aria-hidden="true"></div>

  <!-- HUD corners -->
  <div class="pl-hud pl-hud--tl">NITK SURATHKAL</div>
  <div class="pl-hud pl-hud--tr">23—25 OCT 2026</div>
  <div class="pl-hud pl-hud--bl" data-js="pl-boot">BOOTING INTERFACE</div>
  <div class="pl-hud pl-hud--br">SCANLINE 60HZ</div>

  <div class="pl-stack">
    <!-- Shard-built wordmark: the homepage ENGINEER'26 logotype, sliced into
         three diagonal shards (each a clipped copy of the same image) so it
         comes apart during the burst. RGB-split + glow are CSS drop-shadows on
         the image, driven by the same JS vars the text version used. -->
    <div class="pl-wm" data-js="pl-wm" aria-hidden="true">
      <% for (var i = 1; i <= 3; i++) { %>
      <div class="pl-shard pl-shard--<%= i %>">
        <img class="pl-shard__img" src="/images/engineer26-wordmark.png?v=2" alt="" decoding="async">
      </div>
      <% } %>
      <!-- Torn slivers: thin sheared bands of the logotype that tear off during
           the burst. Pre-rendered and hidden; preloader.js drives clip-path/offset. -->
      <% for (var v = 0; v < 5; v++) { %>
      <img class="pl-sliver" src="/images/engineer26-wordmark.png?v=2" alt="" aria-hidden="true" style="display:none;">
      <% } %>
    </div>

    <div class="pl-readout">
      <p class="pl-sub" data-js="pl-sub">COGNITRIXX</p>
      <div class="pl-track"><span class="pl-fill" data-js="pl-fill"></span></div>
      <div class="pl-status">
        <span data-js="pl-msg">REWIRING REALITY</span>
        <span class="pl-pct" data-js="pl-pct">000%</span>
      </div>
    </div>
  </div>

  <div class="pl-scan" aria-hidden="true"></div>
  <div class="pl-vignette" aria-hidden="true"></div>
</div>

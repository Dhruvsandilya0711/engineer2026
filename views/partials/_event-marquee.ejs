<!-- ==========================================================================
     EVENT BAND — the programme as two slim kinetic rows of names.

     Every name is a real event from data/events.json and links to its own
     page; nothing is invented. The rows are a CSS loop (public/js/motion.js
     → initMarquees only nudges their speed with scroll and slows them under
     the cursor). Each renders its set twice for a seamless loop; the second
     copy is aria-hidden and out of the tab order, so a keyboard or screen
     reader meets each event once.
     ========================================================================== -->
<%
  const trackAccent = { technical: 'var(--bay-1)', startup: 'var(--bay-3)', talks: 'var(--bay-6)', care: 'var(--rgb-amber)', campus: 'var(--bay-4)' };
%>
<section class="evband" aria-labelledby="evband-title">
  <div class="evband__head rail">
    <div class="evband__count" aria-hidden="true"><%= events.all.length %></div>
    <div class="evband__intro">
      <h2 id="evband-title" class="evband__title" data-split>Events across<br>three days</h2>
      <p class="evband__lead" data-reveal>Robotics, aeromodelling, hackathons, talks and the campus itself — five tracks, one programme.</p>
    </div>
    <a href="/events" class="btn btn-secondary evband__all" data-js="magnetic" data-reveal>Browse all events</a>
  </div>

  <%# Two slim rows of real event names, travelling against each other.
      Type only — the gallery below is the photographic moment, so this band
      does not repeat it. Hovering a name floats that event's photo beside
      the cursor (data-preview) and slows the row. %>
  <% const half = Math.ceil(events.all.length / 2); %>
  <% [events.all.slice(0, half), events.all.slice(half)].forEach(function (row, r) { %>
  <div class="mq evband__row<%= r ? ' evband__row--alt' : '' %>" data-marquee data-marquee-hover>
    <div class="mq__track" style="--mq-dur: <%= r ? 90 : 80 %>s">
      <% for (let copy = 0; copy < 2; copy++) { %>
      <ul class="mq__group"<%- copy ? ' aria-hidden="true"' : '' %>>
        <% row.forEach(function (e) { %>
        <li class="evband__cell" style="--accent: <%= trackAccent[e.track] || 'var(--bay-1)' %>">
          <a class="evband__item" href="/events/<%= e.slug %>"
             data-preview="<%= e.image || '' %>"<%- copy ? ' tabindex="-1"' : '' %>>
            <span class="evband__cat"><%= e.category %></span>
            <span class="evband__name"><%= e.name %></span>
          </a>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </div>
  <% }); %>
</section>

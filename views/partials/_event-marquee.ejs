<!-- ==========================================================================
     EVENT BAND — the programme on two crossing HUD tapes.

     Each tape is built from the same parts as the nav bar: a glass plate
     with the spectrum hairline, and bay-style segments (index, label, hatch
     slab, floor bloom on hover) — one segment per real event from
     data/events.json, each linking to its page. The tapes cross at a slight
     angle and run against each other.

     The travel is a CSS loop (public/js/motion.js → initMarquees nudges its
     speed with scroll and slows it under the cursor). Each tape renders its
     set twice for a seamless loop; the second copy is aria-hidden and out of
     the tab order, so a keyboard or screen reader meets each event once.
     ========================================================================== -->
<%
  const trackAccent = { technical: 'var(--bay-1)', talks: 'var(--bay-6)', campus: 'var(--bay-4)', nights: 'var(--bay-5)' };
  // The band shows the competitions: what people enter, and what the "All"
  // link opens. Shows and expos live on the schedule.
  const list = competitions;
  const half = Math.ceil(list.length / 2);
  const tapes = [list.slice(0, half), list.slice(half)];
%>
<section class="evband" aria-labelledby="evband-title" style="--accent: var(--bay-3)">
  <div class="rail evband__head">
    <div class="deck-card__head evband__bar">
      <span class="deck-card__num">03</span>
      <span class="deck-card__name">Competitions</span>
      <span class="deck-card__slab" aria-hidden="true"></span>
      <span class="deck-card__line" aria-hidden="true"></span>
      <a class="deck-card__go" href="/competitions">All <%= list.length %> &rarr;</a>
    </div>
    <h2 id="evband-title" class="chapter-title chapter-title--md" data-split>
      <%= list.length %> competitions.<br><span class="text-gradient-impossible">Three days.</span>
    </h2>
  </div>

  <div class="evband__tapes">
    <% tapes.forEach(function (tape, t) { %>
    <div class="evtape evtape--<%= t ? 'b' : 'a' %>">
      <div class="mq" data-marquee data-marquee-hover>
        <div class="mq__track" style="--mq-dur: <%= t ? 95 : 85 %>s">
          <% for (let copy = 0; copy < 2; copy++) { %>
          <ul class="mq__group"<%- copy ? ' aria-hidden="true"' : '' %>>
            <% tape.forEach(function (e) { const n = list.indexOf(e) + 1; %>
            <li class="evchip-cell" style="--bay-accent: <%= trackAccent[e.track] || 'var(--bay-1)' %>">
              <a class="evchip" href="/events/<%= e.slug %>"
                 data-preview="<%= e.image || '' %>"<%- copy ? ' tabindex="-1"' : '' %>>
                <span class="evchip__idx"><%= String(n).padStart(2, '0') %></span>
                <span class="evchip__name"><%= e.name %></span>
                <span class="evchip__cat"><%= e.category %></span>
                <span class="evchip__slab" aria-hidden="true"></span>
              </a>
            </li>
            <% }); %>
          </ul>
          <% } %>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
</section>

<!-- ==========================================================================
     EVENT SHOWCASE — the programme as a slow reel of event plates.

     Every plate is a real event from data/events.json and links to its own
     page; nothing is invented. Events that have no photograph yet get a
     lit plate in their track's accent rather than a broken image.

     The reel is a CSS loop (public/js/motion.js → initMarquees only nudges
     its speed with scroll and slows it under the cursor). It renders the set
     twice for a seamless loop; the second copy is aria-hidden and out of the
     tab order, so a keyboard or screen reader meets each event once.
     ========================================================================== -->
<%
  const trackAccent = { technical: 'var(--bay-1)', startup: 'var(--bay-3)', talks: 'var(--bay-6)', care: 'var(--rgb-amber)', campus: 'var(--bay-4)' };
%>
<section class="evband" aria-labelledby="evband-title">
  <div class="evband__head rail">
    <div class="evband__count" aria-hidden="true"><%= events.all.length %></div>
    <div class="evband__intro">
      <h2 id="evband-title" class="evband__title" data-split>Events across<br>three days</h2>
      <p class="evband__lead" data-reveal>Robotics, aeromodelling, hackathons, talks and the campus itself — five tracks, one programme.</p>
    </div>
    <a href="/events" class="btn btn-secondary evband__all" data-js="magnetic" data-reveal>Browse all events</a>
  </div>

  <div class="mq evband__reel" data-marquee data-marquee-hover>
    <div class="mq__track" style="--mq-dur: 120s">
      <% for (let copy = 0; copy < 2; copy++) { %>
      <ul class="mq__group"<%- copy ? ' aria-hidden="true"' : '' %>>
        <% events.all.forEach(function (e) { %>
        <li class="evcard" style="--accent: <%= trackAccent[e.track] || 'var(--bay-1)' %>">
          <a class="evcard__link" href="/events/<%= e.slug %>"<%- copy ? ' tabindex="-1"' : '' %>>
            <span class="evcard__media">
              <% if (e.image) { %>
              <img src="<%= e.image %>" alt="" loading="lazy" decoding="async" draggable="false">
              <% } else { %>
              <span class="evcard__plate" aria-hidden="true"></span>
              <% } %>
            </span>
            <span class="evcard__body">
              <span class="evcard__cat"><%= e.category %></span>
              <span class="evcard__name"><%= e.name %></span>
            </span>
          </a>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </div>
</section>

<!-- ==========================================================================
     DECK — the homepage nav destinations, dealt out as a stack of sticky cards.

     Card order, accents and index numbers mirror the hero nav bays. HOME is
     the hero itself, so the deck's first CARD is 01 ABOUT. Keep the two in
     step: bays = Home / About / Events / Schedule / Team / Sponsors; cards =
     About / Events / Schedule / Team / Sponsors.

     Each card is a real section with a real id, so /#about, /#events,
     /#schedule, /#team and /#sponsors all resolve and nothing is hidden behind
     JS — the stacking is CSS `position: sticky` (see .deck in input.css) and
     GSAP only adds the scale-and-dim as a card is covered.
     ========================================================================== -->
<div class="deck" id="deck">

  <!-- 01 ABOUT -->
  <div class="deck-item" style="--i: 0">
    <article class="deck-card" style="--accent: 34,211,238">
      <div class="deck-card__inner">
        <div class="deck-card__head">
          <span class="deck-card__num">01</span>
          <span class="deck-card__name">About</span>
          <span class="deck-card__slab" aria-hidden="true"></span>
          <span class="deck-card__line" aria-hidden="true"></span>
        </div>
        <div class="deck-card__body" data-lenis-prevent>
          <%- include('_about-engineer', { festDates }) %>
        </div>
      </div>
      <span class="deck-card__scrim" data-js="deck-scrim" aria-hidden="true"></span>
    </article>
  </div>

  <!-- 02 EVENTS -->
  <div class="deck-item" style="--i: 1">
    <article class="deck-card" style="--accent: 99,102,241">
      <div class="deck-card__inner">
        <div class="deck-card__head">
          <span class="deck-card__num">02</span>
          <span class="deck-card__name">Events</span>
          <span class="deck-card__slab" aria-hidden="true"></span>
          <span class="deck-card__line" aria-hidden="true"></span>
          <a class="deck-card__go" href="/events">All <%= events.all.length %> &rarr;</a>
        </div>
        <div class="deck-card__body" data-lenis-prevent>
          <%- include('_events-rail', { events, regState }) %>
        </div>
      </div>
      <span class="deck-card__scrim" data-js="deck-scrim" aria-hidden="true"></span>
    </article>
  </div>

  <!-- 03 SCHEDULE -->
  <div class="deck-item" style="--i: 2">
    <article class="deck-card" style="--accent: 108,124,244">
      <div class="deck-card__inner">
        <div class="deck-card__head">
          <span class="deck-card__num">03</span>
          <span class="deck-card__name">Schedule</span>
          <span class="deck-card__slab" aria-hidden="true"></span>
          <span class="deck-card__line" aria-hidden="true"></span>
          <a class="deck-card__go" href="/schedule">Full schedule &rarr;</a>
        </div>
        <div class="deck-card__body" data-lenis-prevent>
          <%- include('_schedule-preview', { scheduleDays }) %>
        </div>
      </div>
      <span class="deck-card__scrim" data-js="deck-scrim" aria-hidden="true"></span>
    </article>
  </div>

  <!-- 04 TEAM -->
  <div class="deck-item" style="--i: 3">
    <article class="deck-card" style="--accent: 128,146,246">
      <div class="deck-card__inner">
        <div class="deck-card__head">
          <span class="deck-card__num">04</span>
          <span class="deck-card__name">Team</span>
          <span class="deck-card__slab" aria-hidden="true"></span>
          <span class="deck-card__line" aria-hidden="true"></span>
          <a class="deck-card__go" href="/team">Open &rarr;</a>
        </div>
        <div class="deck-card__body" data-lenis-prevent>
          <%- include('_team-preview', { teamTotal, teamGroupCount }) %>
        </div>
      </div>
      <span class="deck-card__scrim" data-js="deck-scrim" aria-hidden="true"></span>
    </article>
  </div>

  <!-- 05 SPONSORS — the deck's closer. -->
  <div class="deck-item" style="--i: 4">
    <article class="deck-card" style="--accent: 232,121,249">
      <div class="deck-card__inner">
        <div class="deck-card__head">
          <span class="deck-card__num">05</span>
          <span class="deck-card__name">Sponsors</span>
          <span class="deck-card__slab" aria-hidden="true"></span>
          <span class="deck-card__line" aria-hidden="true"></span>
          <a class="deck-card__go" href="/#footer">Partner &rarr;</a>
        </div>
        <div class="deck-card__body" data-lenis-prevent>
          <%- include('_sponsors') %>
        </div>
      </div>
    </article>
  </div>

</div>

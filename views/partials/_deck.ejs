<!-- ==========================================================================
     FANDECK — the homepage's five chapters, dealt as a tilted horizontal fan.

     The cards rest overlapping in 3D, all leaning the same way like a fanned
     hand. Hover lifts a card toward you; clicking one OPENS it — it flies to
     the centre, straightens, and expands to a full panel showing its real
     content (a FLIP morph in public/js/main.js → initFanDeck). A scrim closes
     it, as does Esc or the ✕.

     The deck USED to be About / Events / Schedule / Team / Sponsors — the
     same five destinations as the nav bar directly above it, so opening a
     card only ever restated a link the visitor could already see. It now
     carries the material that has nowhere else to live on this page: the
     fest's scale, its programme tracks, its CSR work, the pro shows, and the
     partner network. Navigation stays where navigation belongs — the bays.
     ========================================================================== -->
<%
  const cards = [
    { id: 'scale',     i: 0, num: '01', name: 'Scale',     accent: '34,211,238',
      teaser: '15K+ footfall, 200+ colleges, running since ' + fest.founded + '.' },
    { id: 'programme', i: 1, num: '02', name: 'Programme', accent: '99,102,241',
      teaser: 'Five tracks, ' + events.all.length + ' events, three days.',
      go: { href: '/events', label: 'All ' + events.all.length + ' &rarr;' } },
    { id: 'engi-care', i: 2, num: '03', name: 'ENGI Care', accent: '245,158,11',
      teaser: 'The CSR programme — engineering that gives back.' },
    { id: 'nights',    i: 3, num: '04', name: 'After Dark', accent: '214,118,226',
      teaser: 'Pro shows, comedy and the acts ENGINEER has hosted.' },
    { id: 'network',   i: 4, num: '05', name: 'Network',   accent: '232,121,249',
      teaser: 'Alumni companies, research partners, past sponsors.',
      go: { href: '/sponsors', label: 'Partner &rarr;' } },
  ];
%>
<section class="fandeck" id="deck" data-js="fandeck" aria-label="Explore ENGINEER '26">

  <div class="fandeck__intro" data-reveal>
    <h2 class="font-display font-bold text-3xl sm:text-5xl">Inside the fest</h2>
    <p class="fandeck__lead">Hover a card &middot; click to open</p>
  </div>

  <div class="fandeck__stage" data-js="fandeck-stage">
    <% cards.forEach(function (c) { %>
    <article class="fancard" id="<%= c.id %>" data-card="<%= c.id %>"
             style="--i: <%= c.i %>; --accent: <%= c.accent %>;">
      <!-- Transparent hit target: opens the card in the fan state; hidden once
           open so the real content (links, close, scroll) takes the clicks. -->
      <button class="fancard__hit" type="button" data-js="fancard-open"
              aria-expanded="false" aria-label="Open <%= c.name %>"></button>

      <div class="fancard__plate">
        <div class="deck-card__head">
          <span class="deck-card__num"><%= c.num %></span>
          <span class="deck-card__name"><%= c.name %></span>
          <span class="deck-card__slab" aria-hidden="true"></span>
          <span class="deck-card__line" aria-hidden="true"></span>
          <% if (c.go) { %><a class="deck-card__go" href="<%= c.go.href %>"><%- c.go.label %></a><% } %>
          <button class="fancard__close" type="button" data-js="fancard-close" aria-label="Close <%= c.name %>">&#10005;</button>
        </div>

        <!-- Fan face: a short teaser + the OPEN hint (both hidden once open). -->
        <p class="fancard__teaser"><%= c.teaser %></p>
        <span class="fancard__hint" aria-hidden="true">Open &#8599;</span>

        <!-- Full content: hidden in the fan, revealed when the card opens. -->
        <div class="fancard__body deck-card__body" data-lenis-prevent>
          <% if (c.id === 'scale') { %><%- include('_deck-scale', { fest }) %>
          <% } else if (c.id === 'programme') { %><%- include('_deck-programme', { tracks, events }) %>
          <% } else if (c.id === 'engi-care') { %><%- include('_deck-care', { tracks }) %>
          <% } else if (c.id === 'nights') { %><%- include('_deck-nights', { proshows }) %>
          <% } else if (c.id === 'network') { %><%- include('_deck-network', { fest }) %><% } %>
        </div>
      </div>
    </article>
    <% }); %>
  </div>

  <!-- Click-anywhere-to-close backdrop; only live while a card is open. -->
  <button class="fandeck__scrim" type="button" data-js="fandeck-scrim" aria-label="Close card" tabindex="-1"></button>
</section>

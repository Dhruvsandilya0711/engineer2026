<!-- ==========================================================================
     "What is Cognitrixx?" — the storytelling section right after the hero.
     Large short statements first, so the concept lands visually before any
     explanatory copy. See design-system §14 for the per-page motion budget.
     ========================================================================== -->
<section id="cognitrixx" class="relative section-y-lg px-6">
  <div class="max-w-4xl mx-auto text-center">
    <p class="eyebrow text-amber justify-center mb-6" data-reveal>What is Cognitrixx</p>
    <h2 class="font-display font-bold text-4xl sm:text-6xl leading-[1.05]" data-reveal>
      Reality isn't fixed.<br>
      <span class="text-gradient-impossible">It's engineered.</span>
    </h2>
    <p class="font-body text-base sm:text-lg text-[var(--paper-dim)] max-w-xl mx-auto mt-8" data-reveal>
      Cognitrixx is the network of intelligence behind ENGINEER '26 — the idea that a system smart enough,
      and engineered well enough, can rewire what's possible.
    </p>
  </div>

  <div class="max-w-5xl mx-auto grid sm:grid-cols-3 gap-px bg-[var(--hairline)] mt-12 sm:mt-16 border border-[var(--hairline)]">
    <div class="bg-void p-8 text-left" data-reveal>
      <p class="font-mono text-xs tracking-[0.15em] uppercase text-amber mb-4">01 / Cognitrixx</p>
      <h3 class="font-display font-medium text-xl mb-3">The network</h3>
      <p class="text-sm text-[var(--paper-dim)]">Intelligence that senses, connects, and learns — every node aware of the whole.</p>
    </div>
    <div class="bg-void p-8 text-left" data-reveal>
      <p class="font-mono text-xs tracking-[0.15em] uppercase text-magenta mb-4">02 / Rewire</p>
      <h3 class="font-display font-medium text-xl mb-3">The moment it breaks</h3>
      <p class="text-sm text-[var(--paper-dim)]">Structure dissolves and reforms — the instant assumptions stop holding.</p>
    </div>
    <div class="bg-void p-8 text-left" data-reveal>
      <p class="font-mono text-xs tracking-[0.15em] uppercase text-cyan mb-4">03 / Engineer</p>
      <h3 class="font-display font-medium text-xl mb-3">The discipline</h3>
      <p class="text-sm text-[var(--paper-dim)]">What makes the impossible triangle stand — building the shape that shouldn't work.</p>
    </div>
  </div>
</section>

<!-- ==========================================================================
     "What is Cognitrixx?" — the storytelling section right after the hero.
     Large short statements first, so the concept lands visually before any
     explanatory copy. See design-system §14 for the per-page motion budget.
     ========================================================================== -->
<%# data-seam opts this chapter into registerSeams() in public/js/scroll.js:
    its content drifts and dims as the next chapter arrives, so the boundary
    reads as a transition rather than an edge. Only static text chapters take
    it — the pinned transformation, the game canvas and the gallery run their
    own scroll machinery and must not be scrubbed underneath it. %>
<section id="cognitrixx" class="relative intro-y px-6" data-seam>
  <div class="max-w-4xl mx-auto text-center" data-seam-inner>
    <!-- Chapter dateline — the fest's "when + where" as an instrument
         stamp above the thesis. Cyan periods echo the HUD chrome and the
         motto in the hero above; the hairlines either side frame it as a
         single line rather than a caption. -->
    <p class="intro-when" aria-label="<%= festDates.display %>. Join us." data-reveal>
      <span class="intro-when__rule" aria-hidden="true"></span>
      <span class="intro-when__d"><%= festDates.display %></span>
      <span class="intro-when__dot" aria-hidden="true">·</span>
      <span class="intro-when__w">Join Us</span>
      <span class="intro-when__rule" aria-hidden="true"></span>
    </p>
    <h2 class="font-display font-bold text-4xl sm:text-6xl leading-[1.05] mt-6" data-reveal>
      Reality isn't fixed.<br>
      <span class="text-gradient-impossible">It's engineered.</span>
    </h2>
    <p class="font-body text-base sm:text-lg text-[var(--paper-dim)] max-w-xl mx-auto mt-8" data-reveal>
      Cognitrixx is the network of intelligence behind ENGINEER '26 — the idea that a system smart enough,
      and engineered well enough, can rewire what's possible.
    </p>
  </div>
</section>

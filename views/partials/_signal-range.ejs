<!-- ==========================================================================
     SIGNAL RANGE — the site's one interactive moment.
     A bowmaster-style shooter, restyled as a data-signal transmission range.
     Aim with the pointer, hold to charge, release to fire a packet across the
     screen; hit the node's core for the highest score. Sits between the deck
     and the gallery — see public/js/signal-game.js for the mechanics.
     ========================================================================== -->
<section id="signal-range" class="signal-range" aria-label="Interactive signal range">
  <div class="signal-range__head">
    <h2 class="signal-range__title">Fire the signal.</h2>
    <p class="signal-range__lede">
      <span class="signal-range__hint">Aim</span> with the pointer, <span class="signal-range__hint">hold</span> to
      charge the emitter, <span class="signal-range__hint">release</span> to transmit. Hit the node — bullseye is
      100&nbsp;pts, ring hits count too. Three misses and the range resets.
    </p>
  </div>

  <div class="signal-range__arena" data-js="signal-game-mount">
    <canvas class="signal-range__canvas" data-js="signal-game" aria-label="Signal firing range game"></canvas>

    <div class="signal-range__hud">
      <!-- Score / Streak / Signal are role=status live regions so a screen
           reader hears every change. Best is silent — it only bumps on a new
           high and the celebration is visual. aria-atomic makes each update
           re-read the label + value together instead of just the number. -->
      <div class="signal-range__stat" role="status" aria-live="polite" aria-atomic="true">
        <span class="signal-range__stat-l">Score</span>
        <span class="signal-range__stat-v" data-js="sg-score">0</span>
      </div>
      <div class="signal-range__stat" role="status" aria-live="polite" aria-atomic="true">
        <span class="signal-range__stat-l">Streak</span>
        <span class="signal-range__stat-v signal-range__stat-v--accent" data-js="sg-streak">×0</span>
      </div>
      <div class="signal-range__stat">
        <span class="signal-range__stat-l">Best</span>
        <span class="signal-range__stat-v" data-js="sg-best">0</span>
      </div>
      <div class="signal-range__stat signal-range__stat--lives" role="status" aria-live="polite" aria-atomic="true">
        <span class="signal-range__stat-l">Signal</span>
        <span class="signal-range__lives" data-js="sg-lives" role="img" aria-label="Signal at full strength">
          <span class="signal-range__life" aria-hidden="true"></span>
          <span class="signal-range__life" aria-hidden="true"></span>
          <span class="signal-range__life" aria-hidden="true"></span>
        </span>
      </div>
    </div>

    <div class="signal-range__gauge" aria-hidden="true">
      <span class="signal-range__gauge-l">Charge</span>
      <span class="signal-range__gauge-track"><span class="signal-range__gauge-fill" data-js="sg-charge"></span></span>
    </div>

    <%# SAVE ends the run on purpose — see public/js/signal-game.js → endRun().
        Banking a score and playing on would let a player re-save after every
        lucky shot, which would hollow out the streak prize.
        LOAD restores the handle and personal best held on this device; it
        deliberately does NOT restore a run in progress, for the same reason. %>
    <div class="signal-range__actions">
      <button type="button" class="sg-chip" data-js="sg-save">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                d="M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6"/>
        </svg>
        <span>Save run</span>
      </button>
      <button type="button" class="sg-chip" data-js="sg-load">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                d="M4 6h6l2 2h8v10H4zM12 11v5m0 0l-2-2m2 2l2-2"/>
        </svg>
        <span>Load</span>
      </button>
    </div>

    <button type="button" class="signal-range__reset" data-js="sg-reset" aria-label="Restart the signal range">
      <svg class="signal-range__reset-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
              d="M4.5 12a7.5 7.5 0 1 1 2.34 5.44"/>
        <path fill="currentColor" d="M2.5 16.4l1.6-4.9 4.9 1.6z"/>
      </svg>
      <span class="signal-range__reset-label">Restart</span>
      <span class="signal-range__reset-key" aria-hidden="true">R</span>
    </button>
  </div>

  <!-- ============ LEADERBOARD ============
       Two separate boards because the two prizes are separate: ₹2,500 for
       the highest score, ₹2,500 for the longest streak.

       Scores here are SERVER-DERIVED: the browser submits the seed it was
       issued plus the inputs the player made, and the server replays that
       trace to work out what it actually scores. Patching the game changes
       nothing that reaches this table. What it does NOT stop is a bot
       computing good inputs offline — see lib/leaderboard.js. -->
  <div class="lb" data-js="range-board">
    <div class="lb__head">
      <div>
        <h3 class="lb__title">Range leaderboard</h3>
        <p class="lb__prize">
          <span class="lb__amt">&#8377;2,500</span> highest score &middot;
          <span class="lb__amt">&#8377;2,500</span> longest streak
        </p>
      </div>
      <p class="lb__badge lb__badge--ok" title="Every run on this board was replayed and scored by the server from the player's own inputs.">Server-verified</p>
    </div>

    <div class="lb__tabs" role="tablist" aria-label="Leaderboard metric">
      <button type="button" class="lb__tab is-active" data-js="lb-tab" data-metric="score"
              role="tab" aria-selected="true" aria-controls="lb-table-score">Score</button>
      <button type="button" class="lb__tab" data-js="lb-tab" data-metric="streak"
              role="tab" aria-selected="false" aria-controls="lb-table-streak">Streak</button>
    </div>

    <% ['score', 'streak'].forEach(function (m) { %>
    <table class="lb__table" id="lb-table-<%= m %>" data-js="lb-table-<%= m %>" <%= m === 'streak' ? 'hidden' : '' %>>
      <caption class="sr-only">Top runs by <%= m %></caption>
      <thead>
        <tr><th scope="col">#</th><th scope="col">Name</th><th scope="col"><%= m === 'streak' ? 'Streak' : 'Score' %></th></tr>
      </thead>
      <tbody data-js="lb-body-<%= m %>">
        <tr><td class="lb-empty" colspan="3">Loading…</td></tr>
      </tbody>
    </table>
    <% }); %>

    <p class="lb__err" data-js="lb-error" hidden>Leaderboard unavailable right now.</p>

    <!-- Submit panel — revealed when a run ends, or by Load. -->
    <div class="lb__panel" data-js="lb-panel" hidden>
      <p class="lb__summary" data-js="lb-summary"></p>
      <form class="lb__form" data-js="lb-form">
        <label class="sr-only" for="lb-name">Your name for the leaderboard</label>
        <input class="lb__input" id="lb-name" data-js="lb-name" type="text"
               placeholder="Your name" maxlength="20" autocomplete="nickname" required>
        <button type="submit" class="btn btn-primary lb__go" data-js="lb-go">Save to board</button>
        <button type="button" class="lb__dismiss" data-js="lb-dismiss">Not now</button>
      </form>
      <p class="lb-msg" data-js="lb-msg" role="status" aria-live="polite"></p>
      <%# Names go on a public page, so say so where the name is typed rather
          than in a policy nobody opens. %>
      <p class="lb__privacy">
        The name you enter is shown publicly on this page. We also store a
        one-way hash of your IP address to limit repeat submissions — it is
        never displayed and cannot be reversed to your address.
      </p>
    </div>
  </div>
</section>

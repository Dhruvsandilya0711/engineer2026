<!-- ==========================================================================
     SIGNAL RANGE — the site's one interactive moment.
     A bowmaster-style shooter, restyled as a data-signal transmission range.
     Aim with the pointer (a finger on touch), hold to charge, release to fire a packet across the
     screen; hit the node's core for the highest score. Sits between the deck
     and the gallery — see public/js/signal-game.js for the mechanics.
     ========================================================================== -->
<section id="signal-range" class="signal-range" aria-label="Interactive signal range">
  <div class="signal-range__head">
    <h2 class="signal-range__title">Fire the signal.</h2>
    <p class="signal-range__lede">
      <%# "the pointer" / "hold" / "release" are swapped for touch wording by
          public/js/signal-game.js -- see localiseInput(). They are marked
          rather than duplicated so there is one copy to keep correct. %>
      <span class="signal-range__hint">Aim</span> with <span data-js="sg-word-device">the pointer</span>,
      <span class="signal-range__hint" data-js="sg-word-hold">hold</span> to
      charge the emitter, <span class="signal-range__hint" data-js="sg-word-release">release</span> to transmit. Hit the node — bullseye is
      100&nbsp;pts, ring hits count too. Three misses and the range resets.
    </p>
  </div>

  <div class="signal-range__arena" data-js="signal-game-mount">
    <canvas class="signal-range__canvas" data-js="signal-game" aria-label="Signal firing range game"></canvas>

    <%# START SCREEN. The name is taken BEFORE the run, not after it: a run
        is submitted to a prize board the moment it ends, so the player has
        to know they are entering one — and be able to choose the name that
        will appear publicly — before they start playing rather than after
        they have already earned a score. Nothing simulates until Start. %>
    <div class="sg-start" data-js="sg-start">
      <div class="sg-start__box">
        <p class="sg-start__k" data-js="sg-start-kicker">Signal range</p>
        <h3 class="sg-start__t" data-js="sg-start-title">Ready to transmit?</h3>
        <p class="sg-start__sum" data-js="sg-start-summary" hidden></p>

        <label class="sg-start__lab" for="sg-name">Name for the leaderboard</label>
        <input class="sg-start__input" id="sg-name" data-js="sg-name" type="text"
               maxlength="20" placeholder="Your name" autocomplete="nickname" spellcheck="false">
        <p class="sg-start__err" data-js="sg-name-err" role="alert"></p>

        <button type="button" class="sg-start__go" data-js="sg-start-go">Start run</button>

        <p class="sg-start__note">
          <span class="signal-range__hint">Aim</span> with <span data-js="sg-word-device">the pointer</span>,
          <span class="signal-range__hint" data-js="sg-word-hold">hold</span> to charge,
          <span class="signal-range__hint" data-js="sg-word-release">release</span> to fire. Three misses ends the run.
        </p>
        <p class="sg-start__privacy">
          Your name is shown publicly on the leaderboard below. Finished runs are
          submitted automatically.
        </p>
      </div>
    </div>

    <div class="signal-range__hud">
      <!-- Score / Streak / Signal are role=status live regions so a screen
           reader hears every change. Best is silent — it only bumps on a new
           high and the celebration is visual. aria-atomic makes each update
           re-read the label + value together instead of just the number. -->
      <div class="signal-range__stat" role="status" aria-live="polite" aria-atomic="true">
        <span class="signal-range__stat-l">Score</span>
        <span class="signal-range__stat-v" data-js="sg-score">0</span>
      </div>
      <div class="signal-range__stat" role="status" aria-live="polite" aria-atomic="true">
        <span class="signal-range__stat-l">Streak</span>
        <span class="signal-range__stat-v signal-range__stat-v--accent" data-js="sg-streak">×0</span>
      </div>
      <div class="signal-range__stat">
        <span class="signal-range__stat-l">Best</span>
        <span class="signal-range__stat-v" data-js="sg-best">0</span>
      </div>
      <div class="signal-range__stat signal-range__stat--lives" role="status" aria-live="polite" aria-atomic="true">
        <span class="signal-range__stat-l">Signal</span>
        <span class="signal-range__lives" data-js="sg-lives" role="img" aria-label="Signal at full strength">
          <span class="signal-range__life" aria-hidden="true"></span>
          <span class="signal-range__life" aria-hidden="true"></span>
          <span class="signal-range__life" aria-hidden="true"></span>
        </span>
      </div>
    </div>

    <div class="signal-range__gauge" aria-hidden="true">
      <span class="signal-range__gauge-l">Charge</span>
      <span class="signal-range__gauge-track"><span class="signal-range__gauge-fill" data-js="sg-charge"></span></span>
    </div>

    <%# SAVE ends the run on purpose — see public/js/signal-game.js → endRun().
        Banking a score and playing on would let a player re-save after every
        lucky shot, which would hollow out the streak prize.
        LOAD restores the handle and personal best held on this device; it
        deliberately does NOT restore a run in progress, for the same reason. %>
    <div class="signal-range__actions">
      <button type="button" class="sg-chip" data-js="sg-save">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                d="M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6"/>
        </svg>
        <span>Save run</span>
      </button>
      <button type="button" class="sg-chip" data-js="sg-load">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                d="M4 6h6l2 2h8v10H4zM12 11v5m0 0l-2-2m2 2l2-2"/>
        </svg>
        <span>Load</span>
      </button>
    </div>

    <button type="button" class="signal-range__reset" data-js="sg-reset" aria-label="Restart the signal range">
      <svg class="signal-range__reset-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
              d="M4.5 12a7.5 7.5 0 1 1 2.34 5.44"/>
        <path fill="currentColor" d="M2.5 16.4l1.6-4.9 4.9 1.6z"/>
      </svg>
      <span class="signal-range__reset-label">Restart</span>
      <span class="signal-range__reset-key" aria-hidden="true">R</span>
    </button>
  </div>

  <!-- ============ LEADERBOARD ============
       Two separate boards because the two prizes are separate: ₹2,500 for
       the highest score, ₹2,500 for the longest streak.

       Scores here are SERVER-DERIVED: the browser submits the seed it was
       issued plus the inputs the player made, and the server replays that
       trace to work out what it actually scores. Patching the game changes
       nothing that reaches this table. What it does NOT stop is a bot
       computing good inputs offline — see lib/leaderboard.js. -->
  <div class="lb" data-js="range-board">
    <div class="lb__head">
      <div>
        <h3 class="lb__title">Range leaderboard</h3>
        <p class="lb__prize">
          <span class="lb__amt">&#8377;2,500</span> highest score &middot;
          <span class="lb__amt">&#8377;2,500</span> longest streak
        </p>
      </div>
      <p class="lb__badge lb__badge--ok" title="Every run on this board was replayed and scored by the server from the player's own inputs.">Server-verified</p>
    </div>

    <%# PRIZE RULES. Cash is on the line, so every clause here describes what
        the code ACTUALLY does — ties, dedupe and the rate limit are read off
        lib/leaderboard.js, not invented. Keep them in step if that changes.
        Collapsed by default: the people who need them will open them, and
        the section is meant to stay spacious. %>
    <details class="lb__rules">
      <summary class="lb__rules-sum">
        Prize rules
        <span class="lb__rules-hint">closes 25 Oct 2026, 18:00 IST</span>
      </summary>
      <div class="lb__rules-body">
        <ol class="lb__rules-list">
          <li>
            <b>Two prizes, two boards.</b> &#8377;2,500 for the highest single-run
            score and &#8377;2,500 for the longest streak in a single run. They are
            judged separately, so the same run can place on both.
          </li>
          <li>
            <b>Your best run counts.</b> Play as often as you like — each name
            appears once per board, showing only its best result. Later runs never
            replace a better earlier one.
          </li>
          <li>
            <b>Ties go to whoever got there first.</b> On an equal score or streak,
            the run submitted earlier ranks higher. There is no play-off.
          </li>
          <li>
            <b>Enter under a name we can find you by.</b> It is shown publicly on
            this page. 2–20 characters. We cannot pay out to a handle nobody can
            match to a person at the fest.
          </li>
          <li>
            <b>One player can win both.</b> The boards are judged independently
            and nothing is passed down the table. Top the score board and the
            streak board and you take &#8377;5,000.
          </li>
          <li>
            <b>Scores are verified, not trusted.</b> The server replays the inputs
            you made and derives the score itself, so a modified game changes
            nothing here. Submissions are limited to 20 per hour with five seconds
            between them.
          </li>
          <li>
            <b>Automated play is disqualified.</b> Scripted or computed input is
            not a run. Before either prize is paid, the leading entrant will be
            asked to reproduce a comparable result on a supervised device at the
            fest. Declining to is a withdrawal.
          </li>
          <li>
            <b>We can remove an entry.</b> Offensive names and runs we judge to be
            automated come off the board. The organising committee's decision on
            both prizes is final.
          </li>
          <li>
            <b>Closing.</b> The boards freeze at <b>18:00 IST on 25 October 2026</b>.
            Winners are contacted on the email given at registration and must claim
            in person at the fest with a college ID.
          </li>
        </ol>
        <p class="lb__rules-foot">
          We store a one-way hash of your IP address to rate-limit submissions. It
          is never shown, never shared, and cannot be reversed to your address.
        </p>
      </div>
    </details>

    <div class="lb__tabs" role="tablist" aria-label="Leaderboard metric">
      <button type="button" class="lb__tab is-active" data-js="lb-tab" data-metric="score"
              role="tab" aria-selected="true" aria-controls="lb-table-score">Score</button>
      <button type="button" class="lb__tab" data-js="lb-tab" data-metric="streak"
              role="tab" aria-selected="false" aria-controls="lb-table-streak">Streak</button>
    </div>

    <% ['score', 'streak'].forEach(function (m) { %>
    <table class="lb__table" id="lb-table-<%= m %>" data-js="lb-table-<%= m %>" <%= m === 'streak' ? 'hidden' : '' %>>
      <caption class="sr-only">Top runs by <%= m %></caption>
      <thead>
        <tr><th scope="col">#</th><th scope="col">Name</th><th scope="col"><%= m === 'streak' ? 'Streak' : 'Score' %></th></tr>
      </thead>
      <tbody data-js="lb-body-<%= m %>">
        <tr><td class="lb-empty" colspan="3">Loading…</td></tr>
      </tbody>
    </table>
    <% }); %>

    <p class="lb__err" data-js="lb-error" hidden>Leaderboard unavailable right now.</p>

    <%# RESULT panel. There is no name field here any more — the name is taken
        on the start screen, so a finished run submits on its own and this
        just reports what the SERVER scored it and where that placed. %>
    <div class="lb__panel" data-js="lb-panel" hidden>
      <p class="lb__summary" data-js="lb-summary"></p>
      <p class="lb-msg" data-js="lb-msg" role="status" aria-live="polite"></p>
      <button type="button" class="lb__dismiss" data-js="lb-dismiss">Dismiss</button>
      <p class="lb__privacy">
        Names are shown publicly on this page. We also store a one-way hash of
        your IP address to limit repeat submissions — it is never displayed and
        cannot be reversed to your address.
      </p>
    </div>
  </div>
</section>

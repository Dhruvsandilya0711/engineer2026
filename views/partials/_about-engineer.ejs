<!-- ==========================================================================
     ABOUT ENGINEER — the festival itself, distinct from the Cognitrixx theme.
     Only claims that are verifiable from this repo and the brief: NITK's
     annual technical fest, 2026 edition, dates and place. No invented edition
     count, founding year or attendance figures.
     ========================================================================== -->
<section id="about" class="relative section-y px-6" data-seam>
  <div class="absolute inset-0 pointer-events-none" data-field="about" data-density="0.55"
       data-tone="engi" data-signals="4" data-spread="12" data-rotate="0.02" aria-hidden="true"></div>

  <div class="relative max-w-5xl mx-auto" data-seam-inner>
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 items-start">

      <div data-reveal>
        <p class="eyebrow text-violet mb-6">About the festival</p>
        <h2 class="font-display font-bold text-3xl sm:text-5xl leading-[1.04]">
          ENGINEER is<br>the machine.<br>
          <span class="text-gradient-impossible">Cognitrixx</span><br>is the current.
        </h2>
      </div>

      <div class="flex flex-col gap-7">
        <p class="text-base sm:text-lg text-[var(--paper-dim)] leading-relaxed" data-reveal>
          ENGINEER is the annual technical festival of the National Institute of Technology Karnataka,
          Surathkal — built and run by students. Every year it takes a theme. For 2026 that theme is
          <span class="text-paper">COGNITRIXX</span>: a network of intelligent minds, and the idea that
          reality is something you can rewire rather than merely inherit.
        </p>

        <div class="grid sm:grid-cols-3 gap-px bg-[var(--hairline)] border border-[var(--hairline)]" data-reveal>
          <div class="bg-void p-5">
            <p class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-amber mb-2">Edition</p>
            <p class="font-display font-semibold text-lg">ENGINEER '26</p>
          </div>
          <div class="bg-void p-5">
            <p class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-cyan mb-2">Dates</p>
            <p class="font-display font-semibold text-lg"><%= festDates.display.replace(' OCTOBER 2026', '') %> Oct</p>
          </div>
          <div class="bg-void p-5">
            <p class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-magenta mb-2">Place</p>
            <p class="font-display font-semibold text-lg">NITK Surathkal</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3" data-reveal>
          <a href="/events" class="btn btn-secondary">See the programme</a>
          <a href="/register" class="btn btn-primary" data-js="magnetic">Register</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     DECK CARD 03 — ENGI CARE.

     The fest's CSR programme. Copy and the three initiatives are the
     sponsorship brochure's own (§03 Track 04), kept in data/fest.json →
     engiCare. They are CSR work rather than entries in the event schedule,
     so they are listed here without event pages.

     Card-sized: the deck body supplies the padding and the angular frame.
     ========================================================================== -->
<% const care = fest.engiCare || { blurb: '', initiatives: [] }; %>
<section id="engi-care" class="relative">
  <div class="max-w-3xl">
    <p class="eyebrow text-amber mb-5" data-reveal>CSR initiative</p>

    <h2 class="font-display font-bold" data-reveal>
      Engineering<br><span class="text-gradient-impossible">that gives back.</span>
    </h2>

    <p class="text-sm sm:text-base text-[var(--paper-dim)] mt-5 max-w-xl leading-relaxed" data-reveal>
      <%= care.blurb %>
    </p>

    <ul class="care-list mt-8">
      <% care.initiatives.forEach(function (it, i) { %>
      <li class="care" data-reveal>
        <span class="care__n"><%= String(i + 1).padStart(2, '0') %></span>
        <div class="care__b">
          <h3 class="care__name"><%= it.name %></h3>
          <p class="care__d"><%= it.description %></p>
        </div>
      </li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ==========================================================================
     Primary navigation — fixed top bar, transparent over the hero, resolves
     to a solid charcoal bar after ~80px of scroll (public/js/main.js).
     In-page anchors for now: only "/" exists as a route (see audit — full
     /events /schedule /team /sponsors routing is the next build phase).
     ========================================================================== -->
<header id="site-nav" class="fixed top-0 inset-x-0 z-40 transition-colors duration-300<%= typeof deferred !== 'undefined' && deferred ? ' is-deferred' : '' %>" data-js="nav"<%= typeof deferred !== 'undefined' && deferred ? ' data-deferred' : '' %>>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 h-20 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-3 shrink-0" aria-label="ENGINEER '26 home">
      <img src="/images/engineer26logo.png" alt="ENGINEER '26 logo" class="w-9 h-9 object-contain mix-blend-screen"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <span class="hidden w-9 h-9 items-center justify-center border border-[var(--hairline-strong)] font-mono text-[0.6rem] text-cyan">ENGI</span>
      <span class="font-display font-semibold text-sm tracking-wide hidden sm:inline">ENGINEER&nbsp;'26</span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-8 font-mono text-xs tracking-[0.08em] uppercase">
      <% const nav = typeof activeNav !== 'undefined' ? activeNav : ''; %>
      <% const navClass = (id) => id === nav ? 'text-paper border-b border-cyan pb-1' : 'text-[var(--paper-dim)]'; %>
      <a href="/#cognitrixx" class="text-[var(--paper-dim)] hover:text-paper transition-colors">About</a>
      <a href="/events" class="<%= navClass('events') %> hover:text-paper transition-colors">Events</a>
      <a href="/schedule" class="<%= navClass('schedule') %> hover:text-paper transition-colors">Schedule</a>
      <a href="/team" class="<%= navClass('team') %> hover:text-paper transition-colors">Team</a>
      <a href="/register" class="<%= navClass('register') %> hover:text-paper transition-colors">Register</a>
      <a href="/#footer" class="text-[var(--paper-dim)] hover:text-paper transition-colors">Contact</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href="/register" class="btn btn-primary !py-2.5 !px-5 hidden sm:inline-flex" data-js="magnetic">Register</a>
      <button type="button" class="md:hidden w-11 h-11 flex items-center justify-center border border-[var(--hairline-strong)]"
        data-js="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="font-mono text-sm">☰</span>
      </button>
    </div>
  </div>
</header>

<%# Vertical SCROLL / TOP rail — chrome, so it rides along with the nav
    and appears on every page. %>
<%- include('_scroll-rail') %>

<!-- mobile drawer -->
<div id="mobile-drawer" class="fixed inset-0 z-50 bg-void translate-x-full transition-transform duration-300 md:hidden" data-js="drawer">
  <div class="flex items-center justify-between px-6 h-20">
    <span class="font-display font-semibold text-sm">ENGINEER&nbsp;'26</span>
    <button type="button" class="w-11 h-11 flex items-center justify-center border border-[var(--hairline-strong)]"
      data-js="nav-close" aria-label="Close menu">
      <span class="font-mono text-sm">✕</span>
    </button>
  </div>
  <nav aria-label="Mobile" class="flex flex-col px-6 mt-6 gap-1">
    <a href="/#cognitrixx" class="font-display text-3xl py-4 border-b border-[var(--hairline)]" data-js="drawer-link">About</a>
    <a href="/events" class="font-display text-3xl py-4 border-b border-[var(--hairline)]" data-js="drawer-link">Events</a>
    <a href="/schedule" class="font-display text-3xl py-4 border-b border-[var(--hairline)]" data-js="drawer-link">Schedule</a>
    <a href="/team" class="font-display text-3xl py-4 border-b border-[var(--hairline)]" data-js="drawer-link">Team</a>
    <a href="/register" class="font-display text-3xl py-4 border-b border-[var(--hairline)]" data-js="drawer-link">Register</a>
    <a href="/#footer" class="font-display text-3xl py-4 border-b border-[var(--hairline)]" data-js="drawer-link">Contact</a>
    <a href="/register" class="btn btn-primary mt-8 justify-center" data-js="drawer-link">Register</a>
  </nav>
</div>

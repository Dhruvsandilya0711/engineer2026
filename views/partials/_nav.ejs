<!-- ==========================================================================
     Primary navigation — fixed top bar, transparent over the hero, resolves
     to a solid charcoal bar after ~80px of scroll (public/js/main.js).
     Links out to the real routes: /events /schedule /team /sponsors /register
     all exist and are served from index.js. "About" is the one in-page anchor.
     ========================================================================== -->
<header id="site-nav" class="fixed top-0 inset-x-0 z-40 transition-colors duration-300<%= typeof deferred !== 'undefined' && deferred ? ' is-deferred' : '' %>" data-js="nav"<%= typeof deferred !== 'undefined' && deferred ? ' data-deferred' : '' %>>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="ENGINEER '26 home">
      <img class="nav-mark" src="/images/engineer26-mark.png" alt="ENGINEER '26 logo" width="399" height="389">
      <span class="font-display font-semibold text-sm tracking-wide hidden sm:inline">ENGINEER&nbsp;'26</span>
    </a>

    <%# The SAME welded bar the hero carries — so scrolling past the hero swaps
        in the identical instrument, not a plain text menu. %>
    <nav aria-label="Site" class="hidden lg:block">
      <%- include('_nav-bays', {
            variant: 'bar',
            activeNav: (typeof activeNav !== 'undefined' ? activeNav : '')
          }) %>
    </nav>

    <div class="flex items-center gap-4">
      <a href="/register" class="btn-register hidden sm:inline-flex" data-js="magnetic">Register</a>
      <button type="button" class="lg:hidden w-11 h-11 flex items-center justify-center border border-[var(--hairline-strong)]"
        data-js="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="font-mono text-sm">☰</span>
      </button>
    </div>
  </div>
</header>

<%# Vertical SCROLL / TOP rail — chrome, so it rides along with the nav
    and appears on every page. %>
<%- include('_scroll-rail') %>

<%# Page-to-page transition veil. Lives here for the same reason: every page
    gets it, and a navigation can start from any of them. %>
<%- include('_transition') %>

<%# Mute/unmute for the background music. Fixed pill at bottom-right — one
    control sitewide, out of the reading path. Starts muted for autoplay
    policies; the user opts in, and the choice sticks (localStorage). %>
<button type="button" class="audio-toggle" data-js="audio-toggle"
        aria-pressed="false" aria-label="Unmute background music" title="Unmute music"></button>

<!-- mobile drawer -->
<div id="mobile-drawer" class="fixed inset-0 z-50 bg-void translate-x-full transition-transform duration-300 lg:hidden" data-js="drawer">
  <div class="flex items-center justify-between px-6 h-20">
    <span class="font-display font-semibold text-sm">ENGINEER&nbsp;'26</span>
    <button type="button" class="w-11 h-11 flex items-center justify-center border border-[var(--hairline-strong)]"
      data-js="nav-close" aria-label="Close menu">
      <span class="font-mono text-sm">✕</span>
    </button>
  </div>
  <%# The phone gets the SAME bay segments as the desktop bar, stacked — one
      welded column instead of a plain text list. %>
  <nav aria-label="Mobile" class="flex flex-col px-6 mt-6">
    <%- include('_nav-bays', {
          variant: 'drawer',
          drawerLinks: true,
          activeNav: (typeof activeNav !== 'undefined' ? activeNav : '')
        }) %>
    <a href="/register" class="btn-register mt-8" data-js="drawer-link">Register</a>
  </nav>
</div>

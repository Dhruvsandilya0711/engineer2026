<!-- ==========================================================================
     Primary navigation — fixed top bar, transparent over the hero, resolves
     to a solid charcoal bar after ~80px of scroll (public/js/main.js).
     Links out to the real routes: /events /schedule /team /sponsors /register
     all exist and are served from index.js. "About" is the one in-page anchor.
     ========================================================================== -->
<header id="site-nav" class="fixed top-0 inset-x-0 z-40 transition-colors duration-300<%= typeof deferred !== 'undefined' && deferred ? ' is-deferred' : '' %>" data-js="nav"<%= typeof deferred !== 'undefined' && deferred ? ' data-deferred' : '' %>>
  <div class="rail h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="ENGINEER '26 home">
      <img class="nav-mark" src="/images/engineer26-mark.png" alt="ENGINEER '26 logo" width="399" height="389">
      <span class="font-display font-semibold text-sm tracking-wide hidden sm:inline">ENGINEER&nbsp;'26</span>
    </a>

    <%# The SAME welded bar the hero carries — so scrolling past the hero swaps
        in the identical instrument, not a plain text menu. %>
    <nav aria-label="Site" class="hidden lg:block">
      <%- include('_nav-bays', {
            variant: 'bar',
            activeNav: (typeof activeNav !== 'undefined' ? activeNav : '')
          }) %>
    </nav>

    <div class="flex items-center gap-4">
      <a href="/register" class="btn-register hidden sm:inline-flex" data-js="magnetic">Register</a>
      <button type="button" class="hud-menu hud-menu--bar lg:hidden"
        data-js="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="hud-menu__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<%# How far through the page you are: a spectrum hairline across the very top
    of the viewport, above the header, on every page (public/js/motion.js). %>
<div class="scroll-progress" data-js="scroll-progress" aria-hidden="true"></div>

<%# Vertical SCROLL / TOP rail — chrome, so it rides along with the nav
    and appears on every page. %>
<%- include('_scroll-rail') %>

<%# Page-to-page transition veil. Lives here for the same reason: every page
    gets it, and a navigation can start from any of them. %>
<%- include('_transition') %>

<%# Music control. Fixed dock at bottom-right — one control sitewide, out of
    the reading path. The pill mutes; hovering it raises a GAIN COLUMN, seven
    emitter segments read bottom-up like the signal-strength meter the rest of
    the HUD is built from. Both choices stick (localStorage).

    The column is hover/focus driven, so it is desktop and keyboard only —
    the same call as the click SFX. A phone has hardware volume keys and no
    hover state to open it with, and a tap that opened a slider would fight
    the tap that mutes. %>
<div class="audio-dock" data-js="audio-dock">
  <div class="gain" data-js="gain" role="slider" tabindex="0"
       aria-label="Music volume" aria-orientation="vertical"
       aria-valuemin="0" aria-valuemax="7" aria-valuenow="7" aria-valuetext="100%">
    <span class="gain__rail" aria-hidden="true"></span>
    <span class="gain__readout" data-js="gain-readout" aria-hidden="true">100</span>
    <span class="gain__stack" aria-hidden="true">
      <%# Top segment first: the column is read top-down in the DOM and
          bottom-up on screen, which is what a fader does. %>
      <% for (let i = 7; i >= 1; i--) { %><span class="gain__seg" data-seg="<%= i %>"></span><% } %>
    </span>
  </div>
  <button type="button" class="audio-toggle" data-js="audio-toggle"
          aria-pressed="false" aria-label="Unmute background music" title="Unmute music"></button>
</div>

<!-- mobile drawer -->
<div id="mobile-drawer" class="drawer fixed inset-0 z-50 bg-void translate-x-full lg:hidden" data-js="drawer">
  <%# The Penrose mark stands behind the menu as a large, dim watermark — the
      same artwork, untouched, just set back. %>
  <img class="drawer__mark" src="/images/engineer26-mark.png" alt="" aria-hidden="true" width="399" height="389" loading="lazy" decoding="async">
  <div class="flex items-center justify-between px-6 h-20 relative">
    <span class="font-display font-semibold text-sm tracking-wide">ENGINEER&nbsp;'26</span>
    <button type="button" class="hud-menu is-close"
      data-js="nav-close" aria-label="Close menu">
      <span class="hud-menu__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
  <%# The phone gets the SAME bay segments as the desktop bar, stacked — one
      welded column instead of a plain text list. %>
  <nav aria-label="Mobile" class="flex flex-col px-6 mt-6">
    <%- include('_nav-bays', {
          variant: 'drawer',
          drawerLinks: true,
          activeNav: (typeof activeNav !== 'undefined' ? activeNav : '')
        }) %>
    <a href="/register" class="btn-register drawer__cta mt-8" data-js="drawer-link">Register</a>
  </nav>
  <p class="drawer__foot" aria-hidden="true">Cognitrixx &mdash; Rewire Reality</p>
</div>

<!-- ==========================================================================
     GALLERY — built from the real event photographs already in this repo
     (server derives `gallery` from data/events.json). No stock imagery and no
     invented captions: every caption is the event the photo belongs to.
     ========================================================================== -->
<section id="gallery" class="relative section-y px-6 overflow-hidden" data-seam>
  <div class="relative max-w-6xl mx-auto" data-seam-inner>
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10" data-reveal>
      <div>
        <p class="eyebrow text-magenta mb-4">From the floor</p>
        <h2 class="font-display font-bold text-3xl sm:text-5xl">Gallery</h2>
      </div>
      <p class="font-mono text-xs text-[var(--paper-dim)] tracking-[0.1em] uppercase">
        <%= gallery.length %> frames
      </p>
    </div>

    <!-- Mosaic with varied spans so it doesn't read as a uniform card grid.
         Each tile parallaxes very slightly at a depth set by its index. -->
    <ul class="gallery-mosaic">
      <% gallery.forEach(function(g, i){
           const big = i % 7 === 0;
           const tall = i % 5 === 3; %>
      <li class="gallery-tile <%= big ? 'is-wide' : '' %> <%= tall ? 'is-tall' : '' %>" data-reveal>
        <a href="/events/<%= g.slug %>" class="gallery-tile__link">
          <img src="<%= g.image %>" alt="<%= g.caption %>" loading="lazy" decoding="async"
               data-parallax="<%= (i % 3) * 4 + 4 %>">
          <span class="gallery-tile__cap"><%= g.caption %></span>
        </a>
      </li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ==========================================================================
     COGNITRIXX TRANSFORMATION — a conceptual progression, not six literal
     animations (per brief: "the conceptual progression is more important
     than literal animation").

     One pinned section, split in two: the six stage labels crossfade on the
     left, and on the right stands the subject they describe — the ENGINEER
     '26 mark rebuilt as a rotating point cloud, sampled straight from the
     logo PNG (public/js/neural-mark.js). Run the cursor through it and it
     breaks apart, then reforms.

     No HUD frame around the mark. The brackets, tick columns and corner
     marks that were here framed a box far larger than the object inside it,
     which read as clutter at a random distance rather than as instrumentation.
     The mark carries the section on its own.

     Both halves are driven by the same scrubbed ScrollTrigger in
     public/js/main.js — registerNarrative(): the label steps, the mark turns,
     and its scan sharpens.
     ========================================================================== -->
<!-- 200vh (was 300vh): one pinned viewport plus one of scroll travel. At 300vh
     the six stages were spread over ~1600px of otherwise empty scrolling, which
     read as dead space rather than pacing. -->
<section id="transformation" class="relative" data-js="transformation" style="height:200vh;">
  <div class="sticky top-0 h-screen overflow-hidden">
    <div class="transform-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="tf-split">
      <!-- ============ NARRATION ============ -->
      <div class="tf-copy">
        <div class="tf-mid">
        <%# Where you are in the six stages: a large index and a meter that
            fills as the section scrolls. Driven by registerNarrative() in
            public/js/main.js from the same ScrollTrigger as the labels. The
            stage label itself is the readable content, so this is hidden
            from assistive tech rather than read out on every step. %>
        <div class="tf-meter" aria-hidden="true">
          <span class="tf-meter__n" data-js="tf-count">01</span>
          <span class="tf-meter__of">/ 06</span>
          <span class="tf-meter__bar"><span class="tf-meter__fill" data-js="tf-fill"></span></span>
        </div>
        <div class="tf-stages" data-js="transform-stages">
          <span class="transform-stage is-active font-display font-bold" data-stage="0">Neural Network</span>
          <span class="transform-stage font-display font-bold" data-stage="1">Information</span>
          <span class="transform-stage font-display font-bold text-magenta" data-stage="2">Rewire</span>
          <span class="transform-stage font-display font-bold" data-stage="3">Engineering</span>
          <span class="transform-stage font-display font-bold" data-stage="4">Impossible Geometry</span>
          <span class="transform-stage font-display font-bold text-gradient-impossible" data-stage="5">New Reality</span>
        </div>

        <p class="tf-lede">The mark, resolved node by node — six stages of rewiring
          between the network you arrive with and the one you leave with.</p>
        </div>

        <div class="tf-dots" data-js="transform-dots" aria-hidden="true">
          <span class="dot" data-dot="0"></span>
          <span class="dot" data-dot="1"></span>
          <span class="dot" data-dot="2"></span>
          <span class="dot" data-dot="3"></span>
          <span class="dot" data-dot="4"></span>
          <span class="dot" data-dot="5"></span>
        </div>
      </div>

      <!-- ============ SUBJECT ============ -->
      <div class="tf-subject">
        <div class="tf-subject__scene" data-js="neural-mark"></div>
      </div>
    </div>
  </div>
</section>

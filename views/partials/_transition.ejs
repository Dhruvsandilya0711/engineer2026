<!-- ==========================================================================
     PAGE TRANSITIONS — native cross-document view transitions.

     The browser keeps the old page on screen until the new one can paint,
     then the new page rises over it as a sheet while the old one recedes
     (public/src/input.css, "Page transitions"). Nothing covers the screen
     and nothing waits on a timer: the swap starts the moment the next page
     is ready, which is what makes it feel like one continuous site.

     A competition card's picture flies into the event page's header and
     back again (public/js/page-transition.js names it on the way out; the
     listener below names its partner on the way in).

     Browsers without cross-document view transitions simply navigate, as
     any site does. Included from _nav.ejs, so every page has it.
     ========================================================================== -->
<%# Parser-blocking and near the top of <body>, so it runs before the first
    paint: `pagereveal` fires just before the new page is first rendered, and
    a listener added later would miss it. %>
<script nonce="<%= nonce %>">
  (function () {
    // Tells the stylesheet script is running, so motion-only hidden poses
    // (headline masks, the hero entrance) apply. With JS off they never do.
    document.documentElement.classList.add('js');

    var KEY = 'engi26.vt';
    var norm = function (p) { return String(p || '').replace(/index\.html$/, '').replace(/\/+$/, ''); };

    window.addEventListener('pagereveal', function (e) {
      var note = null;
      try { note = JSON.parse(sessionStorage.getItem(KEY) || 'null'); sessionStorage.removeItem(KEY); } catch (err) {}
      var vt = e.viewTransition;
      if (!vt) return;

      // Back/forward through history runs the sheet the other way.
      var act = window.navigation && window.navigation.activation;
      if (act && act.navigationType === 'traverse' && act.from && act.entry && act.entry.index < act.from.index) {
        vt.types.add('back');
      }

      // The partner of the picture the last page sent: the event page's
      // header image, or (coming back) the card that opened it, if that card
      // is on screen to receive it.
      var el = null;
      if (note && note.to === 'event' && norm(note.path) === norm(location.pathname)) {
        el = document.querySelector('[data-vt-media]');
      } else if (note && note.to === 'list' && note.slug) {
        el = document.querySelector('[data-vt-slug="' + note.slug + '"] img');
        if (el) {
          var r = el.getBoundingClientRect();
          if (r.bottom < 0 || r.top > innerHeight) el = null;
        }
      }
      if (!el) return;
      // A header image that arrives by flight is already in place: skip its
      // own wipe-in, which would otherwise clip the picture as it lands.
      var fig = el.closest('[data-img-reveal]');
      if (fig) fig.classList.add('is-in', 'is-instant');
      el.style.viewTransitionName = 'event-media';
      // Unnamed once it has landed, unless the page is already leaving again
      // (a quick second navigation ends this transition early, and the
      // leaving page may have just named the same picture to fly it on).
      vt.finished.finally(function () {
        if (!document.documentElement.classList.contains('vt-leaving')) el.style.viewTransitionName = '';
      });
    });
  })();
</script>

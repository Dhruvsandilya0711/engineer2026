<!-- ==========================================================================
     PAGE TRANSITION — the ENGINEER '26 mark, shattered into blades that wind
     into a spiral and unwind back out. Modelled on the Cognizance loader the
     brief references: dark blades pinwheeling around a bright core, each with
     a lit leading edge, over a radial bloom.

     Every blade is the SAME logo image clipped to its own angular wedge, so
     the mark is genuinely torn apart rather than approximated — assembled, the
     wedges reconstruct the logo exactly. The artwork carries its cyan edge
     glow baked in (engineer26-mark-glow.png), so no blade needs a CSS filter:
     each one is a plain image moved by transform and opacity, which the
     compositor animates on its own however busy the page is.

     Driven by public/js/page-transition.js. Included from _nav.ejs, so it is
     present on every page.
     ========================================================================== -->
<%
  // Wedge geometry. Each blade owns 360/N degrees; the polygon is the pie slice
  // walked in a few steps so the outer edge follows the arc rather than cutting
  // a chord across it. R overshoots the box so corners stay covered.
  const BLADES = 12, R = 96, ARC_STEPS = 4;
  const wedge = (i) => {
    const a0 = (i * 360 / BLADES) - 90;
    const a1 = ((i + 1) * 360 / BLADES) - 90;
    const pts = ['50% 50%'];
    for (let s = 0; s <= ARC_STEPS; s++) {
      const a = (a0 + (a1 - a0) * (s / ARC_STEPS)) * Math.PI / 180;
      pts.push((50 + R * Math.cos(a)).toFixed(2) + '% ' + (50 + R * Math.sin(a)).toFixed(2) + '%');
    }
    return pts.join(', ');
  };
%>
<%# Parser-blocking gate: if this load is the far side of a transition, mark the
    document before the veil paints, so the arriving page is covered from the
    very first frame instead of flashing in and then being hidden.

    It also PLAYS the reveal, and plays it as soon as the document has been
    parsed (readyState "interactive"). It used to wait for DOMContentLoaded,
    which also waits for every module script to download and run, three.js
    included: the viewer sat on the held logo for all of that. Nothing here
    needs those libraries.

    window.__ptRevealed resolves once the veil is gone. The page's 3D scenes
    wait for it (main.js, page.js), so compiling shaders never competes with
    the reveal for the GPU; they fade in after it. %>
<script nonce="<%= nonce %>">
  (function () {
    // Tells the stylesheet script is running, so motion-only hidden poses
    // (headline masks, the hero entrance) apply. With JS off they never do.
    var doc = document, root = doc.documentElement;
    root.classList.add('js');
    var KEY = 'engi26.pt', arriving = false;
    try {
      arriving = sessionStorage.getItem(KEY) === '1';
      if (arriving) sessionStorage.removeItem(KEY);
    } catch (e) {}
    if (!arriving) { window.__ptRevealed = Promise.resolve(); return; }

    root.classList.add('pt-arriving');
    // Tells page-transition.js the arrival is already handled here.
    window.__engiPtArrival = true;
    var revealed;
    window.__ptRevealed = new Promise(function (r) { revealed = r; });

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The blades' flight plus the veil's fade (input.css), with a frame spare.
    var REVEAL_MS = reduced ? 180 : 620;
    var played = false;
    function play() {
      if (played) return;
      played = true;
      var veil = doc.getElementById('page-transition');
      if (!veil) { root.classList.remove('pt-arriving'); revealed(); return; }
      // Hand the held, assembled mark from the gate class to the veil itself
      // and start the flight in the same frame, from that same pose.
      veil.classList.add('is-active');
      requestAnimationFrame(function () {
        root.classList.remove('pt-arriving');
        veil.classList.add('is-revealing');
        setTimeout(function () {
          veil.classList.remove('is-active', 'is-revealing');
          revealed();
        }, REVEAL_MS);
      });
    }
    if (doc.readyState === 'loading') {
      doc.addEventListener('readystatechange', function () { if (doc.readyState !== 'loading') play(); });
      // Belt and braces: never leave the page covered.
      setTimeout(play, 4000);
    } else {
      play();
    }
  })();
</script>
<%# Fetch the next page ahead, so the document is already here when the cover
    finishes and the new page paints at once. Chrome and Edge prefetch a link
    the pointer rests on (or the finger presses), into a cache the navigation
    then uses directly; browsers without speculation rules get a plain
    prefetch from public/js/page-transition.js. Photos (the gallery opens them
    in a lightbox), downloads and anything under /api or /ticket are left out. %>
<script type="speculationrules" nonce="<%= nonce %>">
{"prefetch": [{
  "source": "document",
  "where": { "and": [
    { "href_matches": "/*" },
    { "not": { "href_matches": "/api/*" } },
    { "not": { "href_matches": "/ticket/*" } },
    { "not": { "selector_matches": "[download], [target=_blank], .gflow__link, a[href$='.jpg'], a[href$='.png'], a[href$='.webp'], a[href$='.pdf']" } }
  ] },
  "eagerness": "moderate"
}]}
</script>
<div id="page-transition" class="pt" data-js="page-transition" aria-hidden="true">
  <span class="pt__bloom"></span>
  <div class="pt__mark">
    <% for (let i = 0; i < BLADES; i++) { %>
    <span class="pt__blade" style="--i: <%= i %>; --n: <%= BLADES %>; clip-path: polygon(<%= wedge(i) %>);"></span>
    <% } %>
    <%# The whole mark in one piece, over the blades while they are assembled:
        twelve clipped wedges leave hairline seams in the glow where their
        edges meet, and this hides them on the held frame. %>
    <span class="pt__whole"></span>
  </div>
</div>

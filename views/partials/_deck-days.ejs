<!-- ==========================================================================
     DECK CARD 03 — THREE DAYS.

     The whole schedule at a glance, one column per day, straight from
     data/schedule.json (the organising team's day sheets). Same resolved
     days as /schedule, so the card and the page can never disagree; a time
     the sheet still has as TBD reads "coming soon" in both places.

     Card-sized: the deck body supplies the padding and the angular frame.
     ========================================================================== -->
<section id="days" class="relative">
  <div class="max-w-5xl">
    <p class="eyebrow mb-5" style="color: rgb(var(--bay-4))" data-reveal>The schedule</p>

    <h2 class="font-display font-bold" data-reveal>
      Three days.<br><span class="text-gradient-impossible">One sequence.</span>
    </h2>

    <ul class="days-grid mt-8">
      <% scheduleDays.forEach(function (day) { %>
      <li class="day-col" data-reveal>
        <div class="day-col__head">
          <h3 class="day-col__label"><%= day.label %></h3>
          <span class="day-col__date"><%= day.short %></span>
        </div>
        <p class="day-col__n mt-1"><%= day.slots.length %> <%= day.slots.length === 1 ? 'session' : 'sessions' %></p>
        <ol class="day-col__list">
          <% day.slots.forEach(function (s) { %>
          <li class="day-slot">
            <span class="day-slot__t<%= s.when ? '' : ' is-tba' %>"><%= s.allDay ? 'All day' : s.time || 'Soon' %></span>
            <% if (s.linkedEvent) { %>
            <a class="day-slot__n" href="/events/<%= s.linkedEvent.slug %>"><%= s.title %></a>
            <% } else { %>
            <span class="day-slot__n"><%= s.title %></span>
            <% } %>
          </li>
          <% }); %>
        </ol>
      </li>
      <% }); %>
    </ul>

    <a href="/schedule" class="btn btn-secondary mt-8" data-reveal>Full schedule &rarr;</a>
  </div>
</section>

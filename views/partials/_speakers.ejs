<!-- ==========================================================================
     ENGI TALKS / SPEAKERS — no speaker data exists in this codebase yet.
     Per the content rule, this ships as an honest structural placeholder,
     not invented names. Swap the `speakers` array (server-side, from a real
     data source) for the roster once it exists — the markup is ready.
     ========================================================================== -->
<section id="speakers" class="relative section-y px-6">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12" data-reveal>
      <p class="eyebrow text-magenta mb-4">Engi Talks</p>
      <h2 class="font-display font-bold text-3xl sm:text-5xl">The speaker line-up</h2>
      <p class="text-[var(--paper-dim)] mt-4 max-w-lg">Confirmed speakers publish here as the roster locks — nothing below is a placeholder name, because we don't put words in anyone's mouth before they've agreed to say them.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <% for (let i = 1; i <= 4; i++) { %>
      <div class="card-bracket p-6" data-reveal>
        <p class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-[var(--paper-faint)] mb-6">Slot 0<%= i %></p>
        <div class="h-3 w-4/5 bg-[var(--hairline-strong)] mb-3"></div>
        <div class="h-3 w-3/5 bg-[var(--hairline)] mb-8"></div>
        <p class="font-mono text-[0.65rem] tracking-[0.1em] uppercase text-[var(--paper-faint)]">Announcing soon</p>
      </div>
      <% } %>
    </div>
  </div>
</section>

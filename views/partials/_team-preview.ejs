<!-- ==========================================================================
     TEAM (deck card 05) — a card-sized front for /team.

     data/team.json ships with an EMPTY members array on purpose: naming
     people in roles they may not hold is not a placeholder, it is a false
     claim. So the counts render only once there is a real roster, and until
     then the card says so plainly rather than showing invented faces.
     ========================================================================== -->
<section id="team" class="relative">
  <div class="max-w-4xl">
    <p class="eyebrow text-[rgb(214,118,226)] mb-5" data-reveal>Cognitrixx / the people</p>

    <h2 class="font-display font-bold" data-reveal>
      The network<br><span class="text-gradient-impossible">behind it.</span>
    </h2>

    <p class="text-[var(--paper-dim)] max-w-xl mt-5 text-sm sm:text-base leading-relaxed" data-reveal>
      Cognitrixx is a network of intelligent minds — and the ones that built it are students at
      NITK Surathkal who run ENGINEER every year.
    </p>

    <% if (teamTotal) { %>
      <div class="grid grid-cols-2 gap-px bg-[var(--hairline)] border border-[var(--hairline)] mt-8 max-w-md" data-reveal>
        <div class="bg-void p-5">
          <p class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-[rgb(214,118,226)] mb-2">Members</p>
          <p class="font-display font-semibold text-2xl"><%= teamTotal %></p>
        </div>
        <div class="bg-void p-5">
          <p class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-cyan mb-2">Teams</p>
          <p class="font-display font-semibold text-2xl"><%= teamGroupCount %></p>
        </div>
      </div>
    <% } else { %>
      <div class="border border-[var(--hairline)] mt-8 p-5 max-w-md" data-reveal>
        <p class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-[var(--paper-faint)] mb-2">Roster</p>
        <p class="text-sm text-[var(--paper-dim)]">
          Publishes here as the organising team is confirmed — real names only, once they hold the role.
        </p>
      </div>
    <% } %>

    <a href="/team" class="btn btn-secondary mt-6" data-reveal>Meet the team &rarr;</a>
  </div>
</section>

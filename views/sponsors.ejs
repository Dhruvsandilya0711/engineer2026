<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sponsors — ENGINEER '26 · Cognitrixx</title>
  <meta name="description" content="The sponsors, industry partners and alumni companies behind ENGINEER, NITK Surathkal's technical festival.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/cognitrixx-icon-64.png?v=<%= assetV %>">
  <link rel="icon" href="/favicon.ico?v=<%= assetV %>" sizes="any">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=<%= assetV %>">
  <link href="/src/output.css?v=<%= assetV %>" rel="stylesheet">
</head>
<body class="bg-void text-paper font-body antialiased">
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div data-field="ambient" data-priority="2" data-density="1.06" data-tone="nebula" data-signals="9" data-spread="13" data-rotate="0.012" data-depth="18" class="absolute inset-0"></div>
    <div class="bg-grain absolute inset-0"></div>
    <div class="scanlines absolute inset-0"></div>
    <div class="field-vignette absolute inset-0"></div>
  </div>

  <%- include('partials/_nav', { activeNav: 'sponsors' }) %>

  <main class="relative z-10 pt-28 pb-20">
    <div class="rail">

      <%
        const sponsorTitle = `Powering<br><span class="text-gradient-impossible">the system.</span>`;
        const sponsorMeta = `<p class="font-mono text-xs text-[var(--paper-dim)] tracking-[0.1em] uppercase">`
          + `<span class="text-paper">${fest.pastSponsors.length}</span> sponsors &middot; `
          + `<span class="text-paper">${fest.industryPartners.length}</span> industry partners<br>`
          + `<span class="text-[var(--paper-faint)]">Since ${fest.founded} &middot; NITK Surathkal</span></p>`;
      %>
      <%- include('partials/_page-hero', { accent: 'var(--bay-6)', num: '06', nav: 'Sponsors', kicker: 'Cognitrixx / sponsors', title: sponsorTitle, meta: sponsorMeta }) %>

      <p class="text-[var(--paper-dim)] max-w-xl mt-6">
        The brands, labs and companies that have stood behind ENGINEER since <%= fest.founded %>.
      </p>

      <div class="hud-frame mt-6" style="--accent: var(--bay-6)">
        <div class="hud-frame__inner"><div class="hud-frame__body">

        <!-- ============ SPONSORS ============
             Brands that have backed ENGINEER in previous editions — the
             headline wall of this page, so shown at full strength. -->
        <section aria-labelledby="sponsors">
          <div class="section-head">
            <h2 id="sponsors" class="font-display font-semibold text-xl">Our sponsors</h2>
            <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase">Previous editions</p>
          </div>
          <%- include('partials/_logo-wall', { items: fest.pastSponsors, size: 'lg' }) %>
        </section>

        <!-- ============ INDUSTRY & RESEARCH PARTNERS ============
             Standing collaborations of the host institute rather than fest
             sponsorships, so they are kept distinct from the wall above. -->
        <section class="mt-16" aria-labelledby="partners">
          <div class="section-head">
            <h2 id="partners" class="font-display font-semibold text-xl">Industry &amp; research partners</h2>
          </div>
          <%- include('partials/_logo-wall', { items: fest.industryPartners }) %>

          <ul class="centre-list mt-10" data-reveal>
            <% fest.centres.forEach(function (c, i) { %>
            <li class="centre">
              <span class="centre__n"><%= String(i + 1).padStart(2, '0') %></span>
              <span class="centre__b">
                <span class="centre__name"><%= c.name %></span>
                <% if (c.note) { %><span class="centre__note"><%= c.note %></span><% } %>
              </span>
            </li>
            <% }); %>
          </ul>
        </section>

        <!-- ============ ALUMNI COMPANIES ============ -->
        <section class="mt-16" aria-labelledby="alumni">
          <div class="section-head">
            <h2 id="alumni" class="font-display font-semibold text-xl">Founded by alumni</h2>
            <p class="font-mono text-xs text-[var(--paper-faint)] tracking-[0.1em] uppercase">250+ startups</p>
          </div>
          <%- include('partials/_logo-wall', { items: fest.alumniCompanies, muted: true }) %>
        </section>

        <div class="mt-16 flex justify-center" data-reveal>
          <a href="/#footer" class="btn btn-primary" data-js="magnetic">Partner with us</a>
        </div>

        </div></div></div>
    </div>
  </main>

  <%- include('partials/_footer') %>

  <script type="module" src="/js/motion.js?v=<%= assetV %>"></script>
  <script type="module" src="/js/page.js?v=<%= assetV %>"></script>
</body>
</html>

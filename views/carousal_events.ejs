<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>carousal 2</title>

    <!-- Swiper css -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link href="./src/output.css" rel="stylesheet">
    <style>
        .swiper-slide {
            width: 450px;
            height: 450px;
            border-radius: 40px;
            overflow: hidden;
            border-radius: 20px;
            box-shadow: -1px 8px 8px #1e1e1e;
            filter: blur(2px);
            opacity: 0.8;

            transition: filter 0.4s ease, opacity 0.4s ease, transform 0.4s ease;

        }

        .swiper-slide-active {
            border: 1px solid rgb(229, 226, 226);
 
            filter: blur(0);
            opacity: 1;
        }

        .swiper-pagination-bullet {
            background: #ffffff !important;
            opacity: 0.5;
            width: 12px;
            height: 12px;
            transition: all 0.3s ease;
        }

        .swiper-pagination-bullet-active {
            background: #42bef4 !important;
            opacity: 1;
            width: 24px;
            border-radius: 6px;

        }

        .swiper-pagination {
            background: rgba(0, 0, 0, 0.4);
            padding: 8px 12px;
            border-radius: 20px;
            width: auto !important;
            left: 50% !important;
            transform: translateX(-50%);
            margin: 0px;
            border: 1px groove rgb(237, 236, 236);
        }

        #typewriter-text {
            border-right: 3px solid #ffffff;
            white-space: nowrap;
            overflow: hidden;
            animation: blink-cursor 0.75s step-end infinite;
        }

        @keyframes blink-cursor {

            from,
            to {
                border-color: transparent
            }

            50% {
                border-color: #ffffff;
            }
        }
    </style>
</head>

<body class="w-screen h-screen">
    <section class="w-full h-full flex flex-col justify-center items-center ">

        <h1 id="typewriter-text"
            class="text-5xl text-white font-black tracking-wide min-h-20 flex items-center justify-center  "> </h1>

        <h2 id="card-title"
            class="mt-20 mb-10 px-7 py-3 text-white font-semibold tracking-wider rounded-2xl text-3xl backdrop-blur-sm text-shadow-[-1px_4px_black] border border-slate-300 ">
        </h2>
        <!-- Slider main container -->
        <div class="swiper   max-w-4xl ">
            <!-- events slider wrapper -->
            <div class="swiper-wrapper p-10">
                <!-- Slides -->

                <div class="swiper-slide"><img src="images/robowars.png" class="object-cover w-full h-full"
                        alt="robowars"></div>

                <div class="swiper-slide"><img src="images/hackathon.png" class="object-cover w-full h-full"
                        alt="hackathon"></div>

                <div class="swiper-slide"><img src="images/robocon_expo.png" class="object-cover w-full h-full"
                        alt="robocon_expo"></div>

                <div class="swiper-slide"><img src="images/engi_talks.png" class="object-cover w-full h-full"
                        alt="engi_talks"></div>

                <div class="swiper-slide"><img src="images/workshops.png" class="object-cover w-full h-full"
                        alt="workshops"></div>

                <div class="swiper-slide"><img src="images/line_tracker_bot_race.png" class="object-cover w-full h-full"
                        alt="line_tracker_bot_race"></div>
                <div class="swiper-slide"><img src="images/robo_soccer.png" class="object-cover w-full h-full"
                        alt="robo_soccer"></div>

                <div class="swiper-slide"><img src="images/wright_flight.png" class="object-cover w-full h-full"
                        alt="wright_flight"></div>

                <div class="swiper-slide"><img src="images/drone_race.png" class="object-cover w-full h-full"
                        alt="drone-race"></div>

                <div class="swiper-slide"><img src="images/robo_racing.png" class="object-cover w-full h-full"
                        alt="robo_racing"></div>

                <div class="swiper-slide"><img src="images/open_house_labs.png" class="object-cover w-full h-full"
                        alt="open_house_labs"></div>
                <div class="swiper-slide"><img src="images/tech_space_quizzers.png" class="w-full h-full"
                        alt="tech_space_quizzers"></div>
                <div class="swiper-slide"><img src="images/beach_event.png" class="object-cover w-full h-full"
                        alt="beach_event"></div>

                <div class="swiper-slide"><img src="images/tech_mela.jpg" class="object-cover w-full h-full"
                        alt="tech_mela"></div>

            </div>

            <div class="swiper-pagination"></div>

        </div>

    </section>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>

        // carousal swiper js code
        const swiper = new Swiper('.swiper', {
            direction: 'horizontal',
            slidesPerView: 'auto',
            centeredSlides: true,
            spaceBetween: 10,
            loop: true,
            pagination: {
                el: '.swiper-pagination',
                dynamicBullets: true,
                clickable: true

            },
            autoplay: {
                delay: 3000,
                disableOnInterection: false,
            },
            effect: 'coverflow',
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 300,
                modifier:3,
                slideShadows: true
            },
            mousewheel: {
                forceToAxis: true
            }


        })
        swiper.el.addEventListener('mouseenter', () => swiper.autoplay.stop());
        swiper.el.addEventListener('mouseleave', () => swiper.autoplay.start());


        //dynamic typing on events cards
        const text = "Get Ready for What's Next";
        const heading = document.getElementById("typewriter-text");
        let index = 0;
        let hasTyped = false;

        function typeWriter() {
            if (index < text.length) {
                heading.textContent += text.charAt(index);
                index++;
                setTimeout(typeWriter, 60);  
            } else {
                setTimeout(() => {
                    heading.style.borderRight = "none";
                }, 1000);
            }
        }
        const carousalEventsHeadingObserver = new IntersectionObserver((entries, observerInstance) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !hasTyped) {
                    hasTyped = true;
                    typeWriter();
                    observerInstance.unobserve(entry.target);  
                }
            });
        }, {
            threshold: 0.5  
        });
        carousalEventsHeadingObserver.observe(heading);



        //event cards title logic
        let eventTitles = [
            "Robowars",
            "The Engineer Hackathon",
            "Robocon Bot Expo",
            "Engi Talks",
            " Workshops ",
            "Line Tracker Bot Race",
            "Robo Soccer",
            "Wright Flight",
            "Drone Race",
            "Robo Racing",
            "Open House Labs",
            "Tech Space Quizzers",
            "Beach Event",
            "Tech Mela",
        ]
        swiper.on('slideChange', () => {
            document.getElementById("card-title").innerText = eventTitles[swiper.realIndex]
        })
    </script>
</body>

</html>
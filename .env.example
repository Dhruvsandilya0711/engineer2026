# ===========================================================================
#  ENGINEER '26 / Cognitrixx — environment template.
#
#  Copy to .env and fill in. .env is gitignored; this file is not, so it must
#  never hold a real value.
#
#  Nothing here is required to run the site: every variable has a safe
#  fallback and the server prints a warning for the two that matter. What
#  they change is what you can do once real people are on the page.
#
#  Generate a secret with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

# HMAC key for the one-way IP hashes on the leaderboard (lib/leaderboard.js).
# Addresses are never stored or displayed in the clear — only this hash, used
# to rate-limit repeat submissions.
#
# Rotating the salt invalidates every stored hash, which is how you expire
# that data. UNSET: the salt is regenerated per boot, so the rate limiter
# forgets everyone whenever the server restarts.
LEADERBOARD_SALT=

# HMAC key signing the seed issued for each Signal Range run, so a session
# cannot be swapped between issue and submission.
#
# UNSET: falls back to LEADERBOARD_SALT. That works, but keep them separate —
# rotating the IP salt should not silently invalidate every game session that
# happens to be in flight.
RANGE_SECRET=

# Bearer token for POST /api/range/hide, sent as the x-admin-token header.
# It is the only way to take an abusive name off the public leaderboard.
#
# UNSET: the route returns 404 and stays shut, rather than defaulting to open.
# Set this before the leaderboard is public — player names are free text.
ADMIN_TOKEN=

# MongoDB connection string for registrations and leaderboard runs.
#
# UNSET: both fall back to JSON files in data/ (registrations.json and
# leaderboard.json, each gitignored because they hold personal data).
# Set this before hosting the site anywhere but a machine you control — a
# hosted filesystem is ephemeral, and those files would not survive a deploy.
# DBURL=mongodb+srv://user:pass@cluster.mongodb.net/engineer26

# Listen address. Defaults to port 3000 on 0.0.0.0, which also serves the
# LAN; set HOST=127.0.0.1 to bind to this machine only.
# PORT=3000
# HOST=0.0.0.0

# ===========================================================================
#  PAYMENTS — Razorpay. Ported from the engi_nitk_paymentgateway project.
#
#  ALL OF THIS IS OPTIONAL. With no keys, payments are OFF, every event is
#  free, and registration behaves exactly as it did before payments existed.
#  Nothing below has to be set to launch the site.
# ===========================================================================

# Razorpay API keys, from the dashboard (Settings -> API Keys).
# Use the rzp_test_ pair while testing; the rzp_live_ pair only exists once
# the account has cleared KYC, which is NOT instant — allow days for it.
#
# UNSET: payments are off and feeFor() returns free for everything, so the
# site still works end to end. There is no half-on state.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret, set when you add the webhook in the Razorpay
# dashboard. Point the webhook at  <site>/api/pay/webhook  and subscribe it
# to the `payment.captured` event.
#
# UNSET: a payment is only confirmed if the payer's browser survives the
# redirect back. Someone who closes the tab mid-payment is charged and gets
# no ticket. Set this before taking real money.
RAZORPAY_WEBHOOK_SECRET=

# The site's own public origin, e.g. https://engineer.nitk.ac.in
# Needed because the webhook runs with no incoming request to read a host
# from, and because a Host header is attacker-controlled.
#
# UNSET: ticket QR codes and emailed ticket links are built with no host and
# will not resolve. Canonical and og:image URLs fall back to the request.
PUBLIC_ORIGIN=

# Key signing ticket download links, so an order id alone cannot pull down
# someone's name, roll number and email.
#
# UNSET: falls back to RANGE_SECRET, then LEADERBOARD_SALT, then a per-boot
# random key — and on that last one every link already emailed stops working
# the next time the server restarts.
TICKET_SECRET=

# SMTP for posting tickets. EMAIL_APP_PASSKEY is a Gmail App Password, not
# the account password. Ask CCC first — an institutional relay is usually
# better than a personal Gmail for mail claiming to be from the fest.
#
# UNSET: tickets are still generated and still downloadable from the link
# shown after payment, but nothing is posted to the registrant.
EMAIL_ADDRESS=
EMAIL_APP_PASSKEY=
# Defaults to Gmail; override for a CCC relay.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

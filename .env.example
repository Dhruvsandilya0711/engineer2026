# ===========================================================================
#  ENGINEER '26 / Cognitrixx — environment template.
#
#  Copy to .env and fill in. .env is gitignored; this file is not, so it must
#  never hold a real value.
#
#  Nothing here is required to run the site: every variable has a safe
#  fallback and the server prints a warning for the two that matter. What
#  they change is what you can do once real people are on the page.
#
#  Generate a secret with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

# HMAC key for the one-way IP hashes on the leaderboard (lib/leaderboard.js).
# Addresses are never stored or displayed in the clear — only this hash, used
# to rate-limit repeat submissions.
#
# Rotating the salt invalidates every stored hash, which is how you expire
# that data. UNSET: the salt is regenerated per boot, so the rate limiter
# forgets everyone whenever the server restarts.
LEADERBOARD_SALT=

# HMAC key signing the seed issued for each Signal Range run, so a session
# cannot be swapped between issue and submission.
#
# UNSET: falls back to LEADERBOARD_SALT. That works, but keep them separate —
# rotating the IP salt should not silently invalidate every game session that
# happens to be in flight.
RANGE_SECRET=

# Bearer token for POST /api/range/hide, sent as the x-admin-token header.
# It is the only way to take an abusive name off the public leaderboard.
#
# UNSET: the route returns 404 and stays shut, rather than defaulting to open.
# Set this before the leaderboard is public — player names are free text.
ADMIN_TOKEN=

# MongoDB connection string for registrations and leaderboard runs.
#
# UNSET: both fall back to JSON files in data/ (registrations.json and
# leaderboard.json, each gitignored because they hold personal data).
# Set this before hosting the site anywhere but a machine you control — a
# hosted filesystem is ephemeral, and those files would not survive a deploy.
# DBURL=mongodb+srv://user:pass@cluster.mongodb.net/engineer26

# Listen address. Defaults to port 3000 on 0.0.0.0, which also serves the
# LAN; set HOST=127.0.0.1 to bind to this machine only.
# PORT=3000
# HOST=0.0.0.0
